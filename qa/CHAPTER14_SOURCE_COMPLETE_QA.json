  "approved_element_insertions": [
    {
      "element": "<description>Dua bidang koordinat berdampingan. Di kiri, bola satuan terbuka dalam (ℝ², d_E) berupa cakram biru muda berpusat di titik asal dengan batas lingkaran biru putus-putus. Di kanan, bola satuan terbuka dalam (ℝ², d_M) berupa persegi biru muda berpusat di titik asal, dengan sisi x = ±1 dan y = ±1 serta batas biru putus-putus. Garis putus-putus menandai bahwa batas tidak termasuk.</description>",
      "key": "sec_metric_equiv.ptx:100:description"
    }
  ],
