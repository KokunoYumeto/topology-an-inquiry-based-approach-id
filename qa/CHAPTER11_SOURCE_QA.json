  "approved_element_insertions": [
    {
      "element": "<exploration>\n      <task>\n        <statement>\n          <p>\n            Misalkan <m>(X,d) = (\\R,d_E)</m> dan misalkan <m>A = [0,1]</m>.\n            Misalkan <m>0 \\lt a \\lt 1</m>.\n            Apakah himpunan <m>[0,a)</m> terbuka di <m>X</m>?\n            Apakah himpunan <m>[0,a)</m> terbuka di <m>A</m>?\n            Jelaskan.\n          </p>\n        </statement>\n      </task>\n      <task>\n        <statement>\n          <p>\n            Misalkan <m>(X,d) = (\\R,d_E)</m> dan misalkan <m>A = \\Z</m>.\n            Apa saja subhimpunan terbuka dari <m>A</m>?\n            Jelaskan.\n          </p>\n        </statement>\n      </task>\n      <task>\n        <introduction>\n          <p>\n            Misalkan <m>(X,d) = (\\R^2,d_E)</m>,\n            misalkan <m>A = \\{(x,0) \\mid x \\in \\R\\}</m>\n            (sumbu <m>x</m> di <m>\\R^2</m>),\n            dan misalkan <m>Z = \\{(x,0) \\mid 0 \\lt x \\lt 1\\}</m>.\n            Perhatikan bahwa <m>Z \\subset A \\subset X</m>; kita dapat memandang <m>Z</m> sebagai subruang dari <m>A</m> maupun <m>X</m>,\n            serta <m>A</m> sebagai subruang dari <m>X</m>.\n          </p>\n        </introduction>\n            <task>\n              <statement>\n                <p>\n                  Jelaskan mengapa <m>A</m> merupakan subhimpunan tertutup dari <m>X</m>.\n                </p>\n              </statement>\n            </task>\n            <task>\n              <statement>\n                <p>\n                  Jelaskan mengapa <m>Z</m> merupakan subhimpunan terbuka dari <m>A</m>.\n                </p>\n              </statement>\n            </task>\n            <task>\n              <statement>\n                <p>\n                  Apakah <m>Z</m> merupakan subhimpunan terbuka dari <m>X</m>?\n                  Jelaskan.\n                </p>\n              </statement>\n            </task>\n          \n        </task>\n     \n  </exploration>",
      "key": "sec_sub_metric_intro.ptx:57:exploration"
    }
  ],
