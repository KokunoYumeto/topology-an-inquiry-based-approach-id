    {
      "element": "<theorem>\n    <statement>\n      <p>\n        Misalkan <m>(X, \\tau_X)</m> dan\n        <m>(Y, \\tau_Y)</m> merupakan ruang topologi,\n        serta misalkan <m>f: X \\to Y</m> kontinu.\n        Jika <m>A</m> merupakan subhimpunan kompak dari <m>X</m>,\n        maka <m>f(A)</m> merupakan subhimpunan kompak dari <m>Y</m>.\n      </p>\n    </statement>\n  </theorem>",
      "key": "sec_compact_cont.ptx:70:theorem"
    },
    {
      "element": "<theorem xml:id=\"thm_closed_compact\">\n    <statement>\n      <p>\n        Misalkan <m>X</m> ruang topologi kompak.\n        Maka, setiap subhimpunan tertutup dari <m>X</m> kompak.\n      </p>\n    </statement>\n  </theorem>",
      "key": "sec_compact_rn.ptx:293:theorem"
    },
