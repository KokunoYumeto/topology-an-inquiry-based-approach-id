  "approved_element_insertions": [
    {
      "element": "<m>\\R^+ = \\{r \\in \\R \\mid r \\gt 0\\}</m>",
      "key": "sec_glb_exer.ptx:246:m"
    },
    {
      "element": "<p>\n      Lima teorema berikut merupakan sasaran pembuktian dalam latihan-latihan di bawah.\n      Bacalah pernyataannya terlebih dahulu, lalu kembangkan setiap pembuktian melalui\n      urutan tugas yang terkait.\n    </p>",
      "key": "sec_glb_exer.ptx:2:p"
    },
    {
      "element": "<introduction>\n    <p>\n      Lima teorema berikut merupakan sasaran pembuktian dalam latihan-latihan di bawah.\n      Bacalah pernyataannya terlebih dahulu, lalu kembangkan setiap pembuktian melalui\n      urutan tugas yang terkait.\n    </p>\n    <theorem>\n      <title>Sifat Archimedes</title>\n      <idx><h>sifat Archimedes</h></idx>\n      <statement>\n        <p>\n          Untuk setiap bilangan real <m>x</m>, terdapat bilangan asli <m>N</m> sedemikian sehingga <m>N \\gt x</m>.\n        </p>\n      </statement>\n    </theorem>\n    <theorem xml:id=\"thm_Archimedean_2\">\n      <statement>\n        <p>\n          Untuk setiap bilangan real <m>x</m> dan <m>y</m> dengan <m>x \\gt 0</m>,\n          terdapat bilangan asli <m>N</m> sedemikian sehingga <m>Nx \\gt y</m>.\n        </p>\n      </statement>\n    </theorem>\n    <theorem xml:id=\"thm_Archimedean_3\">\n      <statement>\n        <p>\n          Jika <m>x</m> suatu bilangan real positif,\n          maka terdapat bilangan bulat positif <m>N</m> sedemikian sehingga <m>\\frac{1}{N} \\lt x</m>.\n        </p>\n      </statement>\n    </theorem>\n    <theorem>\n      <statement>\n        <p>\n          Untuk sebarang dua bilangan real yang berbeda <m>x</m> dan <m>y</m>,\n          terdapat bilangan rasional yang terletak di antaranya.\n        </p>\n      </statement>\n    </theorem>\n    <theorem>\n      <statement>\n        <p>\n          Untuk sebarang dua bilangan real yang berbeda <m>x</m> dan <m>y</m>,\n          terdapat bilangan irasional yang terletak di antaranya.\n        </p>\n      </statement>\n    </theorem>\n  </introduction>",
      "key": "sec_glb_exer.ptx:1:introduction"
    }
  ],
