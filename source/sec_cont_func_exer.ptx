<exercises xml:id="sec_cont_func_exer">
  
  <exercise>
    <statement>
      <p>
        Misalkan <m>f: \R \to \R</m> didefinisikan oleh <m>f(x) = |x|</m>,
        dengan metrik Euklides pada domain maupun kodomain.
        Apakah <m>f</m> kontinu di <m>x=0</m>?
        Buktikan jawaban Anda.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>f: \R \to \R</m> didefinisikan oleh
        <m>f(x) = \begin{cases}\frac{x}{|x|} \amp \text{ jika } x \neq 0 \\ 1 \amp \text{ jika } x=0. \end{cases}</m> Apakah <m>f</m> kontinu di <m>x=0</m>?
        Buktikan jawaban Anda.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>(Y, d_Y) = (\R, d_E)</m>,
        dengan <m>d_E</m> sebagai metrik Euklides.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>(X,d_X) = (\R^2, d_E)</m>.
              Buktikan atau berikan contoh tandingan: fungsi
              <m>f:X \to Y</m> yang didefinisikan oleh <m>f((x_1,x_2)) = x_1 + x_2</m> bersifat kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>(X,d_X) = (\R^2, d_M)</m>, dengan <m>d_M</m> sebagai metrik maksimum.
              Buktikan atau berikan contoh tandingan: fungsi
              <m>f:X \to Y</m> yang didefinisikan oleh <m>f((x_1,x_2)) = x_1 + x_2</m> bersifat kontinu.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>X</m> sebarang himpunan dan definisikan <m>d : X \times X \to \R</m> dengan
        <me>
          d(x,y) = \begin{cases}0 \amp \text{ jika }  x=y \\ 1 \amp \text{ jika }  x \neq y. \end{cases}
        </me>
        <xref ref="ex_MS_discrete"/>
        meminta kita menunjukkan bahwa <m>d</m> merupakan metrik
        (metrik diskret)
        pada <m>X</m>.
        Misalkan <m>(X,d_X)</m> dan <m>(Y, d_Y)</m> merupakan ruang metrik, dengan <m>d_X</m> sebagai metrik diskret.
        Tentukan semua fungsi kontinu <m>f</m> dari <m>X</m> ke <m>Y</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_sum_continuous">
    <introduction>
      <p>
        Misalkan <m>f</m> dan <m>g</m> merupakan fungsi kontinu dari <m>(\R,d_E)</m> ke <m>(\R, d_E)</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>k \in \R</m> dengan <m>k \neq 0</m> dan definisikan <m>kf : \R \to \R</m> dengan
              <m>(kf)(x) = kf(x)</m> untuk setiap <m>x \in \R</m>.
              Tunjukkan bahwa <m>kf</m> merupakan fungsi kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Definisikan <m>f+g : \R \to \R</m> dengan
              <m>(f+g)(x) = f(x) + g(x)</m> untuk setiap <m>x \in \R</m>.
              Tunjukkan bahwa <m>f+g</m> merupakan fungsi kontinu.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>f</m> dan <m>g</m> merupakan fungsi kontinu dari <m>(\R, d_E)</m> ke <m>(\R,d_E)</m>.
        Dalam soal ini, kita akan membuktikan bahwa <m>fg</m> merupakan fungsi kontinu dari <m>\R</m> ke <m>\R</m>.
        Misalkan <m>a</m> berada di <m>\R</m>,
        dan ikuti langkah-langkah berikut untuk menunjukkan bahwa <m>fg</m> kontinu di <m>x=a</m>.
        Misalkan <m>\epsilon</m> suatu bilangan positif.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Mula-mula, kita akan menyatakan
              <m>f(x)g(x) - f(a)g(a)</m> dalam bentuk yang lebih berguna.
              Gunakan fakta bahwa <m>f(x) = f(a) + (f(x)-f(a))</m> dan <m>g(x)  = g(a) + (g(x)-g(a))</m> untuk menunjukkan bahwa
              <md>
                <mrow>f(x)g(x)-f(a)g(a) = f(a)(g(x)-g(a)) \amp + g(a)(f(x)-f(a))</mrow>
                <mrow> \amp + (f(x)-f(a))(g(x)-g(a))</mrow>
              </md>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jelaskan mengapa terdapat bilangan-bilangan positif <m>\delta_1</m>,
              <m>\delta_2</m>, <m>\delta_3</m>,
              dan <m>\delta_4</m> sedemikian sehingga
              <md>
                <mrow>|f(x)-f(a)| \lt  \sqrt{\frac{\epsilon}{3}} \amp \text{ jika }  |x-a| \lt  \delta_1</mrow>
                <mrow>|g(x)-g(a)| \lt   \sqrt{\frac{\epsilon}{3}}  \amp \text{ jika }  |x-a| \lt  \delta_2</mrow>
                <mrow>|f(x)-f(a)| \lt  \frac{\epsilon}{3(1+|g(a)|)}  \amp \text{ jika }  |x-a| \lt  \delta_3</mrow>
                <mrow>|g(x)-g(a)| \lt  \frac{\epsilon}{3(1+|f(a)|)}  \amp \text{ jika }  |x-a| \lt  \delta_4</mrow>
              </md>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Gunakan hasil dari (a) dan (b) untuk menunjukkan bahwa <m>fg</m> kontinu di <m>x=a</m>. (Petunjuk:
              <m>1+|f(a)| \gt |f(a)|</m>.)
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>f</m> dan <m>g</m> merupakan fungsi dari <m>(\R,d_E)</m> ke <m>(\R,d_E)</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Benarkah bahwa jika <m>f+g</m> merupakan fungsi kontinu,
              maka <m>f</m> dan <m>g</m> juga merupakan fungsi kontinu?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Benarkah bahwa jika <m>fg</m> merupakan fungsi kontinu,
              maka <m>f</m> dan <m>g</m> juga merupakan fungsi kontinu?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>f(x) = 2x^2+1</m> memetakan <m>\R</m> ke <m>\R</m>,
        dengan metrik Euklides pada domain maupun kodomain.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>\epsilon = \frac{1}{4}</m>.
              Carilah nilai <m>\delta</m> sedemikian sehingga
              <m>|x-1| \lt \delta</m> mengakibatkan <m>|f(x)-f(1)| \lt \epsilon</m>.
              Anda dapat menggunakan <url href="external/o003-epsilon-delta-lab.html" visual="external/o003-epsilon-delta-lab.html">Laboratorium epsilon-delta O003</url> untuk memeriksa nilai <m>\delta</m> Anda secara numerik.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa <m>f</m> kontinu di <m>x=1</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_min_1_metric">
    <statement>
      <p>
        Definisikan <m>d: \R \times \R \to \R</m> dengan
        <me>
          d(x,y) = \min\{|x-y|,1\}
        </me>.
        Buktikan bahwa <m>d</m> merupakan metrik.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>f : \R \to \R</m> merupakan fungsi kontinu,
        dengan metrik Euklides pada kedua salinan <m>\R</m>.
        Andaikan <m>f(x) = 0</m> setiap kali <m>x</m> rasional.
        Buktikan bahwa <m>f(x) = 0</m> untuk setiap <m>x \in \R</m>.
        
      </p>
    </statement>
    <hint>
          <p>
            Gunakan <xref ref="ex_GLB_rational"/>.
          </p>
        </hint>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>f: \R \to \R</m> didefinisikan oleh
        <m>f(x) = 0</m> jika <m>x</m> irasional dan
        <m>f(x) = 1</m> jika <m>x</m> rasional.
        Gunakan metrik Euklides pada kedua salinan <m>\R</m>.
        Tunjukkan bahwa <m>f</m> tidak kontinu di titik mana pun dalam <m>\R</m>.
        
      </p>
    </statement>
    <hint>
          <p>
            Gunakan <xref ref="ex_GLB_rational"/>
            dan <xref ref="ex_GLB_irrational"/>.
          </p>
        </hint>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>g: \R \to \R</m> didefinisikan oleh
        <m>g(x) = 0</m> jika <m>x</m> irasional dan
        <m>g(x) = x</m> jika <m>x</m> rasional.
        Gunakan metrik Euklides pada kedua salinan <m>\R</m>.
        Tunjukkan bahwa <m>g</m> hanya kontinu di <m>0</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>a\lt b</m> dan <m>X</m> himpunan semua fungsi kontinu <m>f: [a,b] \to \mathbb{R}</m>.
        Misalkan <m>d^*</m> fungsi jarak pada <m>X</m> yang didefinisikan oleh
        <me>
          d^*(f,g)= \int_a^b \la f(t)-g(t) \ra \, dt
        </me>,
        untuk <m>f, g \in X</m>.
        Untuk setiap <m>f \in X</m>, tetapkan
        <me>
          I(f) = \int_a^b f(t) \, dt
        </me>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tentukan nilai <m>d^*(f,g)</m> ketika <m>f(x) = x^2</m>,
              <m>g(x) = 3-2x</m>, dan <m>[a,b] = [-3,3]</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Tentukan nilai <m>I(f)</m> jika
              <m>f(x) = 2x</m> dan <m>[a,b] = [0,2]</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa fungsi <m>I : (X, d^*) \to (\R,d)</m> bersifat kontinu,
              dengan <m>d</m> sebagai metrik Euklides.
              
            </p>
          </statement>
          <hint>
                <p>
                  Sebelum mencoba membuktikan pernyataan ini, akan membantu jika Anda terlebih dahulu menuliskan secara eksplisit apa artinya <m>I</m> kontinu dalam metrik <m>d^*</m> dan <m>d</m>.
                </p>
              </hint>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawablah benar jika pernyataan itu selalu benar.
        Jika pernyataan itu hanya kadang-kadang benar atau tidak pernah benar,
        jawablah salah dan berikan contoh konkret yang menunjukkan bahwa pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>f : X \to Y</m> suatu fungsi,
              dengan <m>(X, d_X)</m> dan <m>(Y, d_Y)</m> sebagai ruang metrik.
              Jika <m>d_X</m> merupakan metrik diskret dan <m>d_Y</m> sebarang metrik,
              maka <m>f</m> kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>f : X \to Y</m> suatu fungsi,
              dengan <m>(X, d_X)</m> dan <m>(Y, d_Y)</m> sebagai ruang metrik.
              Jika <m>d_Y</m> merupakan metrik diskret dan <m>d_X</m> sebarang metrik,
              maka <m>f</m> kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>d_1</m> dan <m>d_2</m> dua metrik pada suatu himpunan <m>X</m>.
              Fungsi identitas <m>i_X : (X,d_1) \to (X,d_2)</m> yang didefinisikan oleh
              <m>i_X(x) = x</m> untuk setiap <m>x \in X</m> bersifat kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>f</m> dan <m>g</m> merupakan fungsi kontinu dari <m>(\R^2, d_T)</m>
              (metrik taksi)
              ke <m>(\R,d_E)</m>.
              Maka fungsi <m>f+g</m> dari <m>(\R^2, d_T)</m> ke
              <m>(\R,d_E)</m> yang didefinisikan oleh <m>(f+g)(x) = f(x) + g(x)</m> untuk setiap
              <m>x \in \R^2</m> merupakan fungsi kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>(X, d_X)</m> dan <m>(Y,d_Y)</m> merupakan ruang metrik dengan <m>y \in Y</m>,
              maka fungsi konstan <m>f: X \to Y</m> yang didefinisikan oleh
              <m>f(x) = y</m> untuk setiap <m>x \in X</m> merupakan fungsi kontinu.
            </p>
          </statement>
        </task>
  
    </exercise>

</exercises>
