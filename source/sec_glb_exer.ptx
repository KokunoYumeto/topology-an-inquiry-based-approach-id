<exercises xml:id="sec_glb_exer">
  <introduction>
    <p>
      Lima teorema berikut merupakan sasaran pembuktian dalam latihan-latihan di bawah.
      Bacalah pernyataannya terlebih dahulu, lalu kembangkan setiap pembuktian melalui
      urutan tugas yang terkait.
    </p>
    <theorem>
      <title>Sifat Archimedes</title>
      <idx><h>sifat Archimedes</h></idx>
      <statement>
        <p>
          Untuk setiap bilangan real <m>x</m>, terdapat bilangan asli <m>N</m> sedemikian sehingga <m>N \gt x</m>.
        </p>
      </statement>
    </theorem>
    <theorem xml:id="thm_Archimedean_2">
      <statement>
        <p>
          Untuk setiap bilangan real <m>x</m> dan <m>y</m> dengan <m>x \gt 0</m>,
          terdapat bilangan asli <m>N</m> sedemikian sehingga <m>Nx \gt y</m>.
        </p>
      </statement>
    </theorem>
    <theorem xml:id="thm_Archimedean_3">
      <statement>
        <p>
          Jika <m>x</m> suatu bilangan real positif,
          maka terdapat bilangan bulat positif <m>N</m> sedemikian sehingga <m>\frac{1}{N} \lt x</m>.
        </p>
      </statement>
    </theorem>
    <theorem>
      <statement>
        <p>
          Untuk sebarang dua bilangan real yang berbeda <m>x</m> dan <m>y</m>,
          terdapat bilangan rasional yang terletak di antaranya.
        </p>
      </statement>
    </theorem>
    <theorem>
      <statement>
        <p>
          Untuk sebarang dua bilangan real yang berbeda <m>x</m> dan <m>y</m>,
          terdapat bilangan irasional yang terletak di antaranya.
        </p>
      </statement>
    </theorem>
  </introduction>
  
  <exercise>
    <introduction>
      <p>
        Misalkan <m>S</m> suatu subhimpunan tak kosong dari <m>\R</m> yang terbatas di bawah.
        Misalkan <m>a \in \R</m>,
        dan definisikan <m>a+S</m> sebagai <m>a+S = \{a+s \mid s \in S\}</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Jelaskan mengapa <m>a+\inf(S)</m> merupakan batas bawah bagi <m>a+S</m>.
              Jelaskan mengapa <m>a+S</m> memiliki infimum.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>b</m> suatu batas bawah bagi <m>a+S</m>.
              Tunjukkan bahwa <m>a + \inf(S) \geq b</m>.
              Lalu jelaskan mengapa <m>a+\inf(S) = \inf(a+S)</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_GLB_between">
    <introduction>
      <p>
        Misalkan <m>S</m> suatu subhimpunan tak kosong dari <m>\R</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Andaikan <m>S</m> terbatas di atas,
              dan misalkan <m>t = \sup(S)</m>.
              Tunjukkan bahwa untuk setiap <m>r \lt t</m>,
              terdapat bilangan <m>s \in S</m> sedemikian sehingga <m>r \lt s \leq t</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Andaikan <m>S</m> terbatas di bawah,
              dan misalkan <m>t = \inf(S)</m>.
              Tunjukkan bahwa untuk setiap <m>r \gt t</m>,
              terdapat bilangan <m>s \in S</m> sedemikian sehingga <m>t \leq s \lt r</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>A</m> dan <m>B</m> merupakan subhimpunan tak kosong dari <m>\R</m> yang terbatas di atas dan di bawah.
        Misalkan <m>A+B = \{a+b \mid a \in A, b \in B\}</m>.
      </p>
    </introduction>
        <task>
          <introduction>
            <p>
              Ikuti langkah-langkah berikut untuk menunjukkan bahwa <m>\sup(A+B) = \sup(A) + \sup(B)</m>.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Misalkan <m>x = \sup(A)</m> dan <m>y = \sup(B)</m>.
                    Tunjukkan bahwa <m>x+y</m> merupakan batas atas bagi <m>A+B</m>.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Bagian sebelumnya menunjukkan bahwa <m>A+B</m> terbatas di atas sehingga memiliki supremum.
                    Misalkan <m>z = \sup(A+B)</m>.
                    Jelaskan mengapa <m>z \leq x+y</m>.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Untuk menunjukkan bahwa <m>z = x+y</m>, kita harus membuktikan bahwa <m>z</m> tidak mungkin lebih kecil daripada <m>x+y</m>.
                    Andaikan, demi memperoleh kontradiksi, bahwa <m>z \lt x+y</m>.
                    Misalkan <m>\epsilon = x+y-z</m>.
                    Gunakan hasil <xref ref="ex_GLB_between"/> untuk memperoleh kontradiksi.
                  </p>
                </statement>
              </task>
            
          </task>
          <task>
          <statement>
            <p>
              Buktikan bahwa <m>\inf(A+B) = \inf(A) + \inf(B)</m>.
            </p>
          </statement>
          </task>
          <task>
          <statement>
            <p>
              Buktikan atau bantah: <m>\sup(A \cup B) = \max\{\sup(A), \sup(B)\}</m>
            </p>
          </statement>
          </task>
          <task>
          <statement>
            <p>
              Buktikan atau bantah: <m>\inf(A \cup B) = \min\{\inf(A), \inf(B)\}</m>
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_GLB_function_sup_metric">
    <introduction>
      <p>
        Misalkan <m>X = C[a,b]</m>, dengan <m>a,b \in \R,\ a \lt b</m>,
        adalah himpunan semua fungsi kontinu dari <m>[a,b]</m> ke <m>\R</m>.
        Definisikan <m>d: X \times X \to \R</m> dengan
        <me>
          d(f,g) = \sup\{|f(x)-g(x)| \mid x \in [a,b]\}
        </me>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Berapakah <m>d(x^2,1-2x)</m> pada <m>[0,1]</m>?
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa <m>d</m> merupakan metrik pada <m>X</m>.
              Deskripsikan secara geometris bagaimana metrik ini mengukur jarak antara fungsi <m>f</m> dan <m>g</m>. (Metrik ini disebut
              <term>metrik supremum</term>
              atau <term>metrik seragam</term> pada <m>X</m>.)
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_GLB_Archimedean">
    <introduction>
      <p>
        Dalam latihan ini, kita membuktikan <term>sifat Archimedes</term> bilangan asli.
        Perhatikan bahwa himpunan bilangan asli,
        yang dinotasikan dengan <m>\N</m> atau <m>\Z^+</m>,
        adalah himpunan semua bilangan bulat positif.
        Misalkan <m>x</m> suatu bilangan real.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Andaikan tidak terdapat bilangan bulat positif <m>N</m> sedemikian sehingga <m>N > x</m>.
              Jelaskan bagaimana kita dapat menyimpulkan bahwa <m>\Z^+</m> terbatas di atas.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Dengan mengandaikan bahwa <m>\Z^+</m> terbatas di atas,
              jelaskan mengapa <m>\Z^+</m> harus memiliki batas atas terkecil <m>M</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jelaskan mengapa <m>M</m> tidak mungkin menjadi batas atas terkecil bagi <m>\Z^+</m>.
              Jelaskan mengapa hal ini membuktikan sifat Archimedes.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_GLB_Archimedean_2">
    <introduction>
      <p>
        Dalam latihan ini, kita membuktikan dua pernyataan yang ekuivalen dengan sifat Archimedes
        (lihat <xref ref="ex_GLB_Archimedean"/>).
        Kedua pernyataan tersebut dicantumkan dalam pendahuluan kumpulan latihan ini.
      </p>
    </introduction>
        <task>
          <introduction>
            <p>
              Misalkan <m>x</m> dan <m>y</m> bilangan real dengan <m>x \gt 0</m>.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Tunjukkan bahwa jika sifat Archimedes benar,
                    maka <xref ref="thm_Archimedean_2"/> juga benar.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Tunjukkan bahwa jika <xref ref="thm_Archimedean_2"/> benar,
                    maka sifat Archimedes juga benar.
                    Simpulkan bahwa <xref ref="thm_Archimedean_2"/>
                    ekuivalen dengan sifat Archimedes.
                  </p>
                </statement>
              </task>
          
          </task>
          <task>
          <statement>
            <p>
              Buktikan bahwa <xref ref="thm_Archimedean_3"/>
              ekuivalen dengan sifat Archimedes.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_GLB_rational">
    <introduction>
      <p>
        Kita dapat menggunakan batas bawah terbesar untuk membuktikan teorema tentang
        kerapatan bilangan rasional yang dicantumkan dalam pendahuluan kumpulan latihan ini.
        Teorema ini menunjukkan suatu fakta penting <mdash/> bilangan rasional bersifat <term>rapat</term>
        dalam himpunan bilangan real.
        Kita membuktikan teorema ini dalam latihan ini.
        Misalkan <m>x</m> dan <m>y</m> bilangan real dan andaikan <m>x \lt  y</m>.
        Berdasarkan sifat Archimedes bilangan asli
        (lihat <xref ref="ex_GLB_Archimedean">Latihan</xref>
        dan <xref ref="ex_GLB_Archimedean_2"></xref>),
        terdapat bilangan bulat positif <m>n</m> sedemikian sehingga <m>n(y-x) \gt 1</m>.
        Misalkan <m>S = \{k \in \Z \mid k \gt nx \}</m>.
        Sifat Archimedes juga menjamin adanya bilangan bulat positif yang memenuhi
        syarat pembentuk himpunan tersebut; oleh karena itu, himpunan itu tidak kosong.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa <m>S</m> terbatas di bawah dalam <m>\R</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jelaskan mengapa <m>S</m> memuat suatu bilangan bulat <m>m</m> sedemikian sehingga jika
              <m>q \in \Z</m> dengan <m>q \lt m</m>, maka <m>q \leq nx</m>.
              Prinsip Pengurutan Baik berikut mungkin berguna:
            </p>
              <blockquote>
              <p>Setiap subhimpunan tak kosong dari bilangan bulat yang terbatas di bawah memuat infimumnya.</p>
              </blockquote>
            <p>
              (Prinsip Pengurutan Baik merupakan salah satu dari banyak aksioma yang ekuivalen dengan Prinsip Induksi Matematika.
              Prinsip-prinsip ini diterima sebagai aksioma dan dianggap benar.)
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jelaskan mengapa <m>m \gt nx</m> dan <m>m-1 \leq nx</m>.
              Gunakan pertidaksamaan ini bersama dengan <m>n(y-x) \gt 1</m>
              untuk menunjukkan bahwa <m>nx \lt m \lt ny</m>.
              Kemudian, temukan suatu bilangan rasional yang terletak di antara <m>x</m> dan <m>y</m>.
            </p>
          </statement>
        </task>
      
    </exercise>

    <exercise>
    <statement>
      <p>
        Tunjukkan bahwa setiap bola terbuka dalam <m>(\R^2,d_E)</m> memuat suatu titik
        <m>x = (x_1,x_2)</m> dengan <m>x_1</m> dan <m>x_2</m> keduanya rasional.
      </p>
    </statement>
    </exercise>

    <exercise>
    <introduction>
      <p>
        Kita sudah terbiasa menyelesaikan persamaan kuadrat
        <m>x^2-2 = 0</m> dan memperoleh penyelesaian <m>\pm \sqrt{2}</m>.
        Namun, apakah kita benar-benar mengetahui bahwa bilangan <m>\sqrt{2}</m> ada?
        Kita membahas pertanyaan tersebut dalam latihan ini dan menunjukkan keberadaan bilangan
        <m>\sqrt{2}</m> dengan menggunakan batas bawah terbesar.
        Di sini, <m>\R^+ = \{r \in \R \mid r \gt 0\}</m> adalah himpunan bilangan real positif.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Sebagai langkah awal, misalkan <m>S = \{x \in \R^+ \mid x^2 \gt 2\}</m>.
              Jelaskan mengapa <m>S</m> harus memiliki batas bawah terbesar <m>m</m>.
            </p>
          </statement>
        </task>

        <task>
          <introduction>
            <p>
              Selanjutnya, kita menunjukkan bahwa <m>m^2 = 2</m>,
              sehingga <m>m = \sqrt{2}</m>.
              Kita meninjau kasus <m>m^2 \lt  2</m> dan <m>m^2 \gt 2</m>.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Andaikan <m>m^2 \lt  2</m>.
                    Tunjukkan bahwa terdapat bilangan bulat positif <m>n</m> sedemikian sehingga
                    <me>
                      \left(m+\frac{1}{n}\right)^2~\lt ~2
                    </me>.
                    Jelaskan mengapa hal ini juga tidak mungkin terjadi.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Andaikan <m>m^2 \gt 2</m>.
                    Tunjukkan bahwa terdapat bilangan bulat positif <m>n</m> sedemikian sehingga
                    <me>
                      \left(m-\frac{1}{n}\right)^2~\gt~2
                    </me>.
                    Jelaskan mengapa hal ini juga tidak mungkin terjadi.
                  </p>
                </statement>
              </task>
            
          </task>
          <task>
          <statement>
            <p>
              Jelaskan bagaimana kita telah menunjukkan keberadaan <m>\sqrt{2}</m>.
            </p>
          </statement>
        </task>
    </exercise>

    <exercise xml:id="ex_GLB_irrational">
    <introduction>
      <p>
        Serupa dengan <xref ref="ex_GLB_rational"/>,
        kita dapat membuktikan teorema tentang kerapatan bilangan irasional yang
        dicantumkan dalam pendahuluan kumpulan latihan ini.
      </p>
    </introduction>
        <task>
          <introduction>
            <p>
              Langkah pertama adalah menunjukkan keberadaan suatu bilangan irasional.
              Kita akan melakukannya dengan membuktikan bahwa <m>\sqrt{2}</m> irasional.
              Gunakan pembuktian dengan kontradiksi dan andaikan bahwa
              <m>\sqrt{2}</m> merupakan bilangan rasional.
              Artinya, <m>\sqrt{2} = \frac{r}{s}</m> untuk suatu bilangan bulat positif <m>r</m> dan <m>s</m> sedemikian sehingga <m>r</m> dan <m>s</m> tidak memiliki faktor persekutuan positif selain 1.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Jelaskan mengapa <m>r^2=2s^2</m>.
                    Karena <m>2</m> prima, diperoleh bahwa <m>2</m> membagi <m>r</m>.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Tunjukkan bahwa <m>2</m> membagi <m>s</m>.
                    Jelaskan bagaimana hal ini membuktikan bahwa
                    <m>\sqrt{2}</m> merupakan bilangan irasional.
                  </p>
                </statement>
              </task>
            
          </task>
          <task>
          <statement>
            <p>
              Misalkan <m>x</m> dan <m>y</m> dua bilangan real berbeda.
              Tunjukkan bahwa terdapat bilangan bulat <m>q</m> dan bilangan bulat positif <m>N</m> sedemikian sehingga
              <m>z=\frac{q\sqrt{2}}{2^N}</m> merupakan bilangan irasional di antara <m>x</m> dan <m>y</m>.
              
            </p>
          </statement>
          <hint>
                <p>
                  Pertimbangkan pendekatan dalam <xref ref="ex_GLB_rational"/>.
                </p>
              </hint>
        </task>
  </exercise>

  <exercise xml:id="ex_GLB_triangle">
    <statement>
      <p>
        Misalkan <m>(X,d)</m> suatu ruang metrik dan <m>A</m> suatu subhimpunan tak kosong dari <m>X</m>.
        Untuk <m>x,y \in X</m>, buktikan bahwa <m>d(x,A) \leq d(x,y) + d(y,A)</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Buktikan bahwa jika <m>(X,d)</m> suatu ruang metrik dan <m>B</m> serta <m>C</m> subhimpunan tak kosong dari <m>X</m>, maka
        <me>
          d(a, B \cup C) = \min\{d(a,B), d(a,C)\}
        </me>
        untuk setiap <m>a \in X</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawab benar jika pernyataan tersebut selalu benar.
        Jika pernyataan itu hanya kadang-kadang benar atau tidak pernah benar,
        jawab salah dan berikan contoh konkret yang menunjukkan bahwa pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
        Sepanjang latihan ini, misalkan <m>S</m> dan <m>T</m> subhimpunan tak kosong dan terbatas dari <m>\R</m>
        (suatu subhimpunan dari <m>\R</m> disebut terbatas jika terbatas di atas dan di bawah).
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Setiap subhimpunan tak kosong dari <m>S</m> terbatas.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>S + T = \{s+t \mid s \in S, t \in T\}</m>,
              maka <m>\sup(S + T) = \max\{\sup(S), \sup(T)\}</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>S + T = \{s+t \mid s \in S, t \in T\}</m>,
              maka <m>\inf(S + T) = \min\{\inf(S), \inf(T)\}</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>U</m> suatu subhimpunan tak kosong dari <m>S</m>,
              maka <m>\sup(U) \leq \sup(S)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>U</m> suatu subhimpunan tak kosong dari <m>S</m>,
              maka <m>\inf(S) \leq \inf(U)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A</m> suatu subhimpunan tak kosong dari <m>\R</m> dan <m>x \in \R</m> dengan
              <m>d_E(x,A) = 0</m> dalam metrik Euklides, maka <m>x \in A</m>.
            </p>
          </statement>
        </task>
      
    </exercise>
 
</exercises>
