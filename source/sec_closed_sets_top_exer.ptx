<exercises xml:id="sec_closed_sets_top_exer">
  
  <exercise>
    <statement>
      <p>
        Tentukan dengan tepat ruang topologi berhingga mana saja yang merupakan ruang Hausdorff.
        Buktikan hasil Anda.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>(X, \tau)</m> suatu ruang topologi dan <m>A</m> suatu subhimpunan dari <m>X</m>.
        Buktikan bahwa <m>\overline{A} = A \cup \Bdry(A)</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>A</m> suatu subhimpunan dari suatu ruang topologi.
        Buktikan bahwa <m>\Bdry(A) = \emptyset</m> jika dan hanya jika <m>A</m> terbuka sekaligus tertutup.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X</m> suatu himpunan tak kosong dengan sedikitnya dua unsur dan <m>p</m> suatu unsur tetap di <m>X</m>.
        Misalkan <m>\tau_p</m> topologi titik tertentu dan
        <m>\tau_{\overline{p}}</m> topologi titik yang dikecualikan pada <m>X</m>.
        Artinya,
        <ul>
          <li>
            <p>
              <m>\tau_{p}</m> adalah koleksi subhimpunan dari <m>X</m> yang terdiri dari <m>\emptyset</m>,
              <m>X</m>,
              dan semua subhimpunan dari <m>X</m> yang memuat <m>p</m>.
            </p>
          </li>
          <li>
            <p>
              <m>\tau_{\overline{p}}</m> adalah koleksi subhimpunan dari <m>X</m> yang terdiri dari <m>\emptyset</m>,
              <m>X</m>,
              dan semua subhimpunan dari <m>X</m> yang tidak memuat <m>p</m>.
            </p>
          </li>
        </ul>
      
      Fakta bahwa topologi titik tertentu dan topologi titik yang dikecualikan merupakan topologi menjadi pokok bahasan <xref ref="ex_particular_point_topology"/> dan <xref ref="ex_excluded_point_topology"/>.
      Misalkan <m>A = (0,1]</m> suatu subhimpunan dari <m>\R</m>.
      Tentukan, disertai bukti, <m>\overline{A}</m>,
      <m>\Int(A)</m>, dan <m>\Bdry(A)</m> ketika
      </p>
    </introduction>
      <task>
        <statement>
          <p>
            <m>\R</m> memiliki topologi <m>\tau_{p}</m> dengan <m>p = 0</m>
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            <m>\R</m> memiliki topologi <m>\tau_{\overline{p}}</m> dengan <m>p = 0</m>.
          </p>
        </statement>
      </task>
  </exercise>

  <exercise xml:id="ex_Closed_Sets_Sorgenfrey">
  <idx><h>topologi</h><h>limit bawah</h></idx>
  <idx><h>garis Sorgenfrey</h></idx>
    <introduction>
      <p>
        Misalkan <m>\B = \{[a,b) \mid a \lt b \text{ di } \R\}</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa <m>\B</m> merupakan basis untuk topologi <m>\tau_{\ell \ell}</m> pada <m>\R</m>.
              Topologi ini disebut topologi <term>limit bawah</term> pada <m>\R</m>.
              Garis <m>\R</m> dengan topologi
              <m>\tau_{\ell \ell}</m> kadang-kadang disebut
              <term>garis Sorgenfrey</term>
    
              (dinamai menurut matematikawan Robert Sorgenfrey).
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa setiap interval terbuka <m>(a,b)</m> juga merupakan himpunan terbuka dalam topologi limit bawah.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>\tau_1</m> dan <m>\tau_2</m> merupakan topologi pada suatu himpunan <m>X</m> sedemikian sehingga <m>\tau_1 \subseteq \tau_2</m>,
              maka <m>\tau_1</m> dikatakan sebagai topologi yang <term>lebih kasar</term>
              daripada <m>\tau_2</m>,
              atau <m>\tau_2</m> dikatakan sebagai topologi yang <term>lebih halus</term>
              daripada <m>\tau_1</m>.
              Bagian (b) menunjukkan bahwa topologi limit bawah mungkin lebih halus daripada topologi metrik Euklides.
              Tentukan apakah hal ini benar,
              yaitu apakah topologi limit bawah benar-benar lebih halus daripada topologi metrik Euklides pada <m>\R</m>.
              Berikan alasan untuk jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>a \lt b</m>, dengan kedua bilangan tersebut merupakan unsur <m>\R</m>.
              Apakah himpunan <m>[a,b)</m> merupakan himpunan buka-tutup (clopen) dalam <m>(\R, \tau_{\ell \ell})</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Suatu subhimpunan <m>A</m> dari ruang topologi <m>X</m> dikatakan <term>rapat</term>
        dalam <m>X</m> jika <m>\overline{A} = X</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa <m>\Q</m> rapat dalam <m>\R</m> dengan topologi metrik Euklides.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah <m>\Z</m> rapat dalam <m>\R</m> dengan topologi metrik Euklides?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>A</m> suatu subhimpunan dari ruang topologi <m>X</m>.
              Buktikan bahwa <m>A</m> rapat dalam <m>X</m> jika dan hanya jika
              <m>A \cap O \neq \emptyset</m> untuk setiap himpunan terbuka tak kosong <m>O</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X</m> suatu ruang topologi dan <m>A</m> suatu subhimpunan dari <m>X</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa himpunan-himpunan <m>\Int(A)</m>,
              <m>\Bdry(A)</m>, dan <m>\Int(A^c)</m> saling lepas
              (artinya, irisan sebarang dua himpunan tersebut adalah kosong).
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa <m>X = \Int(A) \cup \Bdry(A) \cup \Int(A^c)</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_Closed_sets_Hausdorff_subspace">
    <statement>
      <p>
        Buktikan bahwa subruang dari suatu ruang Hausdorff juga merupakan ruang Hausdorff.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X</m> suatu himpunan tak kosong dengan sedikitnya dua unsur dan <m>p</m> suatu unsur tetap di <m>X</m>.
        Misalkan <m>\tau_p</m> topologi titik tertentu dan
        <m>\tau_{\overline{p}}</m> topologi titik yang dikecualikan pada <m>X</m>.
        Artinya,
        <ul>
          <li>
            <p>
              <m>\tau_{p}</m> adalah koleksi subhimpunan dari <m>X</m> yang terdiri dari <m>\emptyset</m>,
              <m>X</m>,
              dan semua subhimpunan dari <m>X</m> yang memuat <m>p</m>.
            </p>
          </li>
          <li>
            <p>
              <m>\tau_{\overline{p}}</m> adalah koleksi subhimpunan dari <m>X</m> yang terdiri dari <m>\emptyset</m>,
              <m>X</m>,
              dan semua subhimpunan dari <m>X</m> yang tidak memuat <m>p</m>.
            </p>
          </li>
        </ul>
      
      Fakta bahwa topologi titik tertentu dan topologi titik yang dikecualikan merupakan topologi menjadi pokok bahasan <xref ref="ex_particular_point_topology"/> dan <xref ref="ex_excluded_point_topology"/>.
      Tentukan, disertai bukti, apakah <m>X</m> merupakan ruang Hausdorff ketika
      </p>
    </introduction>
      <task>
        <statement>
          <p>
            <m>X</m> memiliki topologi <m>\tau_{p}</m>
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            <m>X</m> memiliki topologi <m>\tau_{\overline{p}}</m>.
          </p>
        </statement>
      </task>
  </exercise>

  <exercise xml:id="ex_TS_Closed_boundary">
    <statement>
      <p>
        Buktikan bahwa suatu subhimpunan <m>C</m> dari ruang topologi <m>X</m> tertutup jika dan hanya jika <m>C</m> memuat batasnya.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Ingat bahwa suatu titik <m>a</m> dalam subhimpunan <m>A</m> dari ruang metrik <m>X</m> merupakan titik terasing dari <m>A</m> jika terdapat lingkungan <m>N</m> dari <m>a</m> di <m>X</m> sedemikian sehingga <m>N \cap A = \{a\}</m>.
        Kita dapat membuat definisi yang sama dalam sebarang ruang topologi.
      </p>
        <definition>
          <statement>
            <p>
              Suatu titik <m>a</m> dalam subhimpunan <m>A</m> dari ruang topologi <m>X</m> merupakan titik terasing dari <m>A</m>
          <idx><h>titik terasing</h></idx>
              jika terdapat lingkungan <m>N</m> dari <m>a</m> sedemikian sehingga <m>N \cap A = \{a\}</m>.
            </p>
          </statement>
        </definition>
    </introduction>
        <task>
          <statement>
            <p>
              Jika <m>A</m> suatu subhimpunan dari ruang topologi <m>X</m>,
              buktikan bahwa suatu titik <m>a \in A</m> merupakan titik terasing dari <m>A</m> jika dan hanya jika <m>\{a\}</m> merupakan himpunan terbuka di <m>A</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Kita telah membuktikan bahwa dalam ruang metrik, setiap titik batas dari suatu himpunan <m>A</m> merupakan titik limit atau titik terasing dari <m>A</m>.
              (Lihat <xref ref="ex_MS_boundary_limit_isolated"/>.)
              Apakah pernyataan yang sama berlaku dalam ruang topologi?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap bilangan bulat <m>a</m>, misalkan <m>a\Z = \{ka \mid k \in \Z\}</m>.
        Artinya, <m>a\Z</m> adalah himpunan semua kelipatan bulat dari <m>a</m>.
        Fakta bahwa <m>\{a\Z \mid a \in \Z\}</m> merupakan basis untuk topologi <m>\tau</m> pada <m>\Z</m> dibahas dalam <xref ref="ex_aZ_top"/>.
        Dalam latihan ini, bekerjalah pada ruang topologi <m>(\Z, \tau)</m>
      </p>
    </introduction>
        <task>
          <introduction>
            <p>
              Misalkan <m>A = \mathbb{E}</m>, yaitu himpunan bilangan bulat genap.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Tentukan, disertai alasan, <m>\Int(A)</m>.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Tentukan, disertai alasan, <m>\overline{A}</m>.
                  </p>
                </statement>
              </task>
        </task>
        <task>
          <introduction>
            <p>
              Misalkan <m>B = \mathbb{N} = \{n \in \Z \mid n \geq 1\}</m>.
              Artinya, <m>\mathbb{N}</m> adalah himpunan bilangan asli.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Tentukan, disertai alasan, <m>\Int(B)</m>.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Tentukan, disertai alasan, <m>\overline{B}</m>.
                  </p>
                </statement>
              </task>
            
          </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Perhatikan topologi Titik Asal Ganda<idx><h>topologi</h><h>Titik Asal Ganda</h></idx> yang didefinisikan sebagai berikut.
        Misalkan <m>X = \R^2 \cup \{0^*\}</m>,
        dengan <m>0^*</m> dipandang sebagai titik yang tidak berada di <m>\R^2</m>
        (<m>0^*</m> adalah titik asal ganda kita).
        Sebagai basis untuk himpunan terbuka,
        kita gunakan bola-bola terbuka standar untuk setiap titik selain <m>0</m> dan <m>0^*</m>.
        Untuk setiap nilai parameter yang positif, pada titik <m>0</m> kita definisikan himpunan-himpunan terbukanya sebagai
        <me>
          N(0,r) = \left\{(x,y) \in \R^2 \mid x^2+y^2 \lt  \frac{1}{r^2}, y \gt 0\right\}  \cup \{0\}
        </me>
        dan untuk setiap nilai parameter yang positif, pada titik <m>0^*</m> kita definisikan himpunan-himpunan terbukanya sebagai
        <me>
          N(0^*, r) =  \left\{(x,y) \in \R^2 \mid x^2+y^2 \lt  \frac{1}{r^2}, y \lt  0\right\}  \cup \{0^*\}
        </me>.
        Jadi, <m>N(0,r)</m> adalah setengah bagian atas dari cakram berjari-jari
        <m>\frac{1}{r}</m> yang berpusat di titik asal,
        dengan sumbu <m>x</m> dikecualikan tetapi titik asal disertakan,
        sedangkan <m>N(0^*,r)</m> adalah setengah bagian bawah dari cakram berjari-jari
        <m>\frac{1}{r}</m> yang berpusat di titik asal,
        dengan sumbu <m>x</m> dikecualikan dan titik <m>0^*</m> disertakan.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa koleksi himpunan yang dijelaskan sebagai basis untuk topologi Titik Asal Ganda benar-benar merupakan basis untuk suatu topologi.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah <m>X</m> dengan topologi Titik Asal Ganda merupakan ruang Hausdorff?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    
      <task>
        <statement>
          <p>
            Tunjukkan bahwa setiap himpunan berhingga merupakan himpunan tertutup dalam <m>\R^n</m> dengan topologi Zariski.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            Tunjukkan bahwa <m>\R^n</m> dengan topologi Zariski bukan ruang Hausdorff. (<xref ref="ex_TS_Zariski"/>
            menunjukkan bahwa suatu basis untuk topologi Zariski pada <m>\R^n</m> adalah koleksi himpunan berbentuk <m>\R^n \setminus Z(f)</m>,
            dengan <m>Z(f)</m> adalah himpunan nol dari polinom <m>f</m> dalam <m>n</m> variabel.)
          </p>
        </statement>
      </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Perhatikan topologi garis digital
        <m>\tau_{dl}</m> pada <m>\Z</m> dengan basis <m>\{B(n)\}</m>, dengan
        <me>
          B(n) = \begin{cases}\{n\}  \amp \text{ jika \(n\) ganjil } , \\ \{n-1,n,n+1\}  \amp \text{ jika \(n\) genap } . \end{cases}
        </me>
      </p>
    </introduction>
        <task>
          <introduction>
            <p>
              Misalkan <m>A = \{-1,0,1\}</m> suatu subhimpunan dari <m>(\Z, \tau_{dl})</m>.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Tentukan titik-titik limit dan titik-titik batas dari <m>A</m>.
                    Buktikan dugaan Anda.
                    Apakah setiap titik limit dari <m>A</m> merupakan titik batas dari <m>A</m>?
                    Apakah setiap titik batas dari <m>A</m> merupakan titik limit dari <m>A</m>?
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Tentukan <m>\overline{A}</m> dan tuliskan
                    <m>\Z \setminus \overline{A}</m> sebagai gabungan himpunan-himpunan terbuka.
                  </p>
                </statement>
              </task>
        </task>
        <task>
          <introduction>
            <p>
              Sekarang perhatikan subhimpunan <m>B = \{0\}</m> dari <m>(\Z, \tau_{dl})</m>.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Tentukan titik-titik limit dan titik-titik batas dari <m>B</m>.
                    Buktikan dugaan Anda.
                    Apakah setiap titik limit dari <m>B</m> merupakan titik batas dari <m>B</m>?
                    Apakah setiap titik batas dari <m>B</m> merupakan titik limit dari <m>B</m>?
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Tentukan <m>\overline{B}</m> dan tuliskan
                    <m>\Z \setminus \overline{B}</m> sebagai gabungan himpunan-himpunan terbuka.
                  </p>
                </statement>
              </task>
            
          </task>
  </exercise>

  <exercise xml:id="ex_Metric_space_regular">
    <introduction>
      <p>
        Misalkan <m>(X,d)</m> suatu ruang metrik. Ingat dari <xref ref="ex_distance_pt_to_set"/> dalam <xref ref="chap_closed_sets"/> bahwa jika <m>C</m> suatu subhimpunan tertutup tak kosong dari ruang metrik <m>X</m> dan <m>x</m> suatu unsur dari <m>X</m>, maka <m>d(x,C) = 0</m> jika dan hanya jika <m>x \in C</m>. Gunakan gagasan ini untuk mengerjakan hal-hal berikut.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          Buktikan bahwa setiap ruang metrik bersifat reguler.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          Buktikan bahwa setiap ruang metrik merupakan ruang normal.
        </p>
      </statement>
    </task>
    
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>K = \left\{\frac{1}{k} \mid k \text{ adalah bilangan bulat positif} \right\}</m>. Misalkan <m>\B</m> koleksi semua interval terbuka berbentuk <m>(a,b)</m> dan semua himpunan berbentuk <m>(a,b) \setminus K</m>, dengan <m>a \lt b</m> bilangan real seperti dalam <xref ref="exp_K_topology"/>. Koleksi <m>\B</m> merupakan basis bagi topologi <m>\tau_K</m> pada <m>\R</m>. Karena koleksi ini memuat semua interval terbuka biasa, <m>\tau_K</m> lebih halus daripada topologi Euklides.
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          Tunjukkan bahwa <m>(\R, \tau_K)</m> merupakan ruang Hausdorff.
        </p>
      </statement>
    </task>
    <task>
      <statement>
        <p>
          <xref ref="ex_Metric_space_regular"/> menunjukkan bahwa setiap ruang metrik bersifat reguler. Pada bagian latihan ini, tunjukkan bahwa <m>(\R, \tau_K)</m> bukan ruang reguler. Kita dapat menyimpulkan bahwa <m>(\R, \tau_K)</m> tidak termetriskan.
        </p>
      </statement>
      <hint>
        <p>
          Perhatikan <m>0</m> dan <m>K</m>.
        </p>
      </hint>
    </task>
    
  </exercise>

  <exercise xml:id="ex_T_1_2_3">
    
      <task>
        <statement>
          <p>
            Buktikan bahwa suatu ruang topologi <m>X</m> merupakan ruang <m>T_1</m> jika dan hanya jika setiap himpunan beranggota tunggal bersifat tertutup.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            Tunjukkan bahwa setiap ruang <m>T_2</m> merupakan ruang <m>T_1</m>,
            setiap ruang <m>T_3</m> merupakan ruang <m>T_2</m>,
            dan setiap ruang <m>T_4</m> merupakan ruang <m>T_3</m>.
          </p>
        </statement>
      </task>
  </exercise>

  <exercise xml:id="ex_not_T_1_2_3">
    <introduction>
      <p>
        Dalam latihan ini, kita memberikan contoh ruang yang merupakan ruang <m>T_1</m> tetapi bukan ruang <m>T_2</m>, serta ruang <m>T_2</m> yang bukan ruang <m>T_3</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa <m>\R</m> dengan topologi komplemen berhingga merupakan ruang <m>T_1</m> tetapi bukan ruang <m>T_2</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Definisikan ruang <m>\R_K</m> seperti dalam <xref ref="exp_K_topology"/>
              sebagai himpunan bilangan real dengan topologi <m>\tau</m> yang memiliki basis berupa interval-interval terbuka standar dalam <m>\R</m> beserta semua himpunan berbentuk <m>(a,b) \setminus K</m>,
              dengan <m>(a,b)</m> sebarang interval terbuka dan <m>K = \left\{\frac{1}{k} \mid k \in \Z^+\right\}</m>.
              Tunjukkan bahwa <m>\R_K</m> merupakan ruang <m>T_2</m> tetapi bukan ruang <m>T_3</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawablah benar jika pernyataan tersebut selalu benar.
        Jika pernyataan hanya kadang-kadang benar atau tidak pernah benar,
        jawablah salah dan berikan contoh konkret yang menunjukkan bahwa pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Setiap titik limit dari suatu subhimpunan <m>A</m> dari ruang topologi <m>X</m> juga merupakan titik batas dari <m>A</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Setiap titik batas dari suatu subhimpunan <m>A</m> dari ruang topologi <m>X</m> juga merupakan titik limit dari <m>A</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>X</m> suatu ruang topologi dan
              <m>A \subseteq X</m> sedemikian sehingga <m>\Int(A)=\overline{A}</m>,
              maka <m>A</m> terbuka sekaligus tertutup.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>X</m> suatu ruang topologi dan <m>A</m> serta <m>B</m> merupakan subhimpunan dari <m>X</m> dengan
              <m>\overline{A}=\overline{B}</m> dan <m>\Int(A) = \Int(B)</m>,
              maka <m>A = B</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A</m> dan <m>B</m> merupakan subhimpunan dari ruang topologi <m>X</m>,
              maka <m>\overline{A \cap B} = \overline{A} \cap \overline{B}</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A</m> dan <m>B</m> merupakan subhimpunan dari ruang topologi <m>X</m>,
              maka <m>\overline{A \cup B} = \overline{A} \cup \overline{B}</m>.
            </p>
          </statement>
        </task>
      
    
  </exercise>
</exercises>
