<exercises xml:id="sec_open_sets_exer">
  
  <exercise>
    <introduction>
      <p>
        Misalkan <m>d</m> metrik diskret.
        Misalkan <m>(X,d)</m> suatu ruang metrik.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa setiap subhimpunan dari <m>X</m> terbuka.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>(Y, d_Y)</m> suatu ruang metrik.
              Buktikan bahwa setiap fungsi <m>f: X \to Y</m> kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah setiap fungsi <m>f: Y \to X</m> juga kontinu?
              Jika ya, buktikan jawaban Anda.
              Jika tidak, carilah sebuah contoh tandingan.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_O_int_O">
    <statement>
      <p>
        Buktikan bahwa suatu subhimpunan <m>O</m> dari ruang metrik <m>X</m> merupakan himpunan terbuka jika dan hanya jika <m>O = \Int(O)</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>A</m> dan <m>B</m> subhimpunan dari ruang metrik <m>X</m> dengan <m>A \subseteq B</m>.
        Buktikan atau sangkal pernyataan-pernyataan berikut.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              <m>\Int(A) \subseteq \Int(B)</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\Int(\Int(A)) = \Int(A)</m>
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>a, b \in \R</m> dengan <m>a \lt b</m>.
        Tunjukkan bahwa himpunan <m>(a,b]</m> dalam <m>(\R, d_E)</m> bukan himpunan terbuka.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>A = \{(x,y) \in \R^2 \mid 1 \lt x \lt 3, 0 \lt y \lt 1\}</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Apakah <m>A</m> merupakan himpunan terbuka dalam <m>(\R^2, d_E)</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah <m>A</m> merupakan himpunan terbuka dalam <m>(\R^2, d_T)</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah <m>A</m> merupakan himpunan terbuka dalam <m>(\R^2, d_M)</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>S</m> suatu himpunan berhingga yang terdiri atas titik-titik dalam <m>\R^2</m>.
        Apakah himpunan <m>\R^2 \setminus S</m> merupakan himpunan terbuka dalam <m>(\R^2, d_E)</m>?
        Buktikan jawaban Anda.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>(X, d_X)</m> dan <m>(Y, d_Y)</m> ruang-ruang metrik, dan misalkan <m>f: X \to Y</m> suatu fungsi.
        Buktikan bahwa <m>f</m> kontinu jika dan hanya jika
        <m>f^{-1}(\Int(B)) \subseteq \Int(f^{-1}(B))</m> untuk setiap subhimpunan <m>B</m> dari <m>Y</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Tinjau ruang metrik <m>(Q,d)</m>,
        dengan <m>d : Q \times Q \to \R</m> didefinisikan oleh
        <me>
          d\left(\frac{a}{b}, \frac{u}{v}\right) = \max\{| a-u |, | b-v |\}
        </me>
        (Fakta bahwa <m>d</m> merupakan metrik dibahas dalam <xref ref="ex_MS_Q_metric"/>.) Deskripsikan bola terbuka <m>B(q,2)</m> dalam <m>Q</m> jika <m>q = \frac{2}{5}</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>(X,d)</m> suatu ruang metrik dan misalkan <m>x_1</m> serta <m>x_2</m> titik-titik berbeda dalam <m>X</m>.
        Buktikan bahwa terdapat himpunan-himpunan terbuka <m>O_1</m> yang memuat <m>x_1</m> dan <m>O_2</m> yang memuat <m>x_2</m> sedemikian sehingga <m>O_1 \cap O_2 = \emptyset</m>.
        (Hal ini menunjukkan bahwa kita dapat memisahkan titik-titik dalam ruang metrik dengan himpunan terbuka.
        Sifat-sifat pemisahan penting dalam topologi.)
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_linear_continuous2">
    <introduction>
      <p>
        Misalkan <m>X = \R</m> dengan metrik Euklides <m>d_E</m>,
        dan misalkan <m>Y = \R</m> dengan metrik <m>d</m> yang didefinisikan oleh <m>d(x,y) = \frac{|x-y|}{|x-y|+1}</m>
        (fakta bahwa <m>d</m> merupakan metrik dibahas dalam <xref ref="ex_1_over_1_plus_t_metric"/>).
        Misalkan <m>a</m> dan <m>b</m> bilangan-bilangan real, dan misalkan
        <m>f:\R \to \R</m> didefinisikan oleh <m>f(x) = ax+b</m>.
        Dengan kata lain, <m>f</m> merupakan fungsi linear sebarang dari <m>\R</m> ke <m>\R</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Deskripsikan bola-bola terbuka dalam <m>(Y, d)</m>.
              Artinya, jika <m>a</m> suatu bilangan real dan <m>\delta</m> suatu bilangan real positif,
              apa tepatnya himpunan titik yang membentuk <m>B(a, \delta)</m> dalam <m>Y</m>?
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah <m>f</m> dari <m>X</m> ke <m>Y</m> kontinu untuk sebarang bilangan real <m>a</m> dan <m>b</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Apakah <m>f</m> dari <m>Y</m> ke <m>X</m> kontinu untuk sebarang bilangan real <m>a</m> dan <m>b</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>f: \R^2 \to \R</m> didefinisikan oleh <m>f((x,y)) = x</m>.
        Asumsikan bahwa kita menggunakan metrik maksimum <m>d_M</m> pada <m>\R^2</m> dan metrik Euklides <m>d_E</m> pada <m>\R</m>.
        Gunakan Teorema untuk menentukan apakah <m>f</m> merupakan fungsi kontinu.
        Buktikan dugaan Anda.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawablah benar jika pernyataannya selalu benar.
        Jika pernyataannya hanya kadang-kadang benar atau tidak pernah benar,
        jawablah salah dan berikan contoh konkret yang menunjukkan bahwa pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Jika <m>A</m> dan <m>B</m> merupakan subhimpunan tak kosong dari ruang metrik <m>X</m>,
              maka <m>\Int(A \cup B) \subseteq \Int(A) \cup \Int(B)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A</m> dan <m>B</m> merupakan subhimpunan tak kosong dari ruang metrik <m>X</m>,
              maka <m>\Int(A) \cup \Int(B) \subseteq \Int(A \cup B)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A</m> dan <m>B</m> merupakan subhimpunan tak kosong dari ruang metrik <m>X</m>,
              maka <m>\Int(A \cap B) \subseteq \Int(A) \cap \Int(B)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A</m> dan <m>B</m> merupakan subhimpunan tak kosong dari ruang metrik <m>X</m>,
              maka <m>\Int(A) \cap \Int(B) \subseteq \Int(A \cap B)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Setiap subhimpunan dari suatu himpunan terbuka dalam ruang metrik <m>(X,d)</m> terbuka dalam <m>X</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Suatu subhimpunan <m>O</m> dari <m>\R^2</m> terbuka terhadap metrik Euklides <m>d_E</m> jika dan hanya jika <m>O</m> terbuka terhadap metrik taksi <m>d_T</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan X = <m>[0,1] \cup [2,3]</m> dilengkapi dengan metrik Euklides.
              Maka <m>[0, 1]</m> merupakan subhimpunan terbuka dari <m>X</m>.
            </p>
          </statement>
        </task>
    
  </exercise>
</exercises>
