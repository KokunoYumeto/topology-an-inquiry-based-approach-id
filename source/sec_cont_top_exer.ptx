<exercises xml:id="sec_cont_top_exer">
  
  <exercise xml:id="ex_isometry_reverse">
    <statement>
      <p>
        Misalkan <m>(X,d_X)</m> dan <m>(Y,d_Y)</m> merupakan ruang metrik yang ekuivalen secara metrik,
        dan misalkan <m>f:X \to Y</m> suatu bijeksi sedemikian sehingga
        <me>
          d_X(x,y) = d_Y(f(x),f(y))
        </me>
        untuk semua <m>x,y \in X</m>.
        Buktikan bahwa
        <me>
          d_Y(u,v) = d_X(f^{-1}(u), f^{-1}(v))
        </me>
        untuk semua <m>u</m> dan <m>v</m> dalam <m>Y</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>(X, \tau_X)</m> dan
        <m>(Y, \tau_Y)</m> merupakan ruang topologi,
        dan misalkan <m>f : X \to Y</m> suatu homeomorfisme.
        Misalkan <m>A</m> suatu himpunan bagian dari <m>X</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Jika <m>x</m> merupakan titik limit dari <m>A</m>,
              apakah <m>f(x)</m> harus merupakan titik limit dari <m>f(A)</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>x</m> merupakan titik interior dari <m>A</m>,
              apakah <m>f(x)</m> harus merupakan titik interior dari <m>f(A)</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>x</m> merupakan titik batas dari <m>A</m>,
              apakah <m>f(x)</m> harus merupakan titik batas dari <m>f(A)</m>?
              Buktikan jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_me_implies_te">
    <statement>
      <p>
        Misalkan <m>(X, d_X)</m> dan <m>(Y, d_Y)</m> merupakan ruang metrik yang ekuivalen secara metrik.
        Tunjukkan bahwa <m>X</m> dan <m>Y</m> ekuivalen secara topologis jika menggunakan topologi metriknya.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_closed_sets_continuity_TS">
    <statement>
      <p>
        Buktikan <xref ref="thm_closed_sets_continuity_TS"/>
        bahwa jika <m>(X,\tau_X)</m> dan
        <m>(Y, \tau_Y)</m> merupakan ruang topologi,
        dan <m>f: X \to Y</m> suatu fungsi,
        maka <m>f</m> kontinu jika dan hanya jika
        <m>f^{-1}(C)</m> merupakan himpunan tertutup dalam <m>X</m> setiap kali <m>C</m> merupakan himpunan tertutup dalam <m>Y</m>.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>(X, \tau_X)</m>, <m>(Y, \tau_Y)</m>,
        dan <m>(Z, \tau_Z)</m> merupakan ruang topologi.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>f: X \to Y</m> dan <m>g : Y \to Z</m> merupakan fungsi kontinu.
              Buktikan bahwa <m>g \circ f : X \to Z</m> merupakan fungsi kontinu.
              
            </p>
          </statement>
          <hint>
                <p>
                  <xref ref="ex_inverse_composite_sets"/> mungkin berguna di sini.
                </p>
              </hint>
        </task>
        <task>
          <introduction>
            <p>
              Misalkan <m>f: (X, \tau_X) \to (Y, \tau_Y)</m> suatu homeomorfisme.
              Misalkan <m>h</m> suatu fungsi dari <m>(Y, \tau_Y)</m> ke
              <m>(Z, \tau_Z)</m> dan misalkan <m>k</m> suatu fungsi dari
              <m>(Z, \tau_Z)</m> ke <m>(X, \tau_X)</m>.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    Buktikan bahwa <m>h</m> kontinu jika dan hanya jika <m>h \circ f</m> kontinu.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Buktikan bahwa <m>k</m> kontinu jika dan hanya jika <m>f \circ k</m> kontinu.
                  </p>
                </statement>
              </task>
            
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X = \{a,b,c,d\}</m> dengan topologi <m>\tau = \{\emptyset, \{a\}, \{b\}, \{a,b\}, \{b,d\}, \{a,b,d\}, X\}</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Temukan fungsi <m>f: X \to X</m> yang kontinu tepat di satu titik,
              atau tunjukkan bahwa fungsi seperti itu tidak ada.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Temukan fungsi <m>f: X \to X</m> yang kontinu tepat di dua titik,
              atau tunjukkan bahwa fungsi seperti itu tidak ada.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Temukan fungsi <m>f: X \to X</m> yang kontinu tepat di tiga titik,
              atau tunjukkan bahwa fungsi seperti itu tidak ada.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Pertimbangkan <m>\R</m> dan <m>\R^2</m> yang dilengkapi topologi Euklides.
        Misalkan <m>f : \R \to \R</m> suatu fungsi dan misalkan
        <me>
          \Gamma_f = \{(x,f(x)) \mid x \in \R\}
        </me>
        merupakan grafik dari <m>f</m>.
        Perhatikan bahwa <m>\Gamma_f</m> merupakan subruang dari <m>\R^2</m> dan menjadi ruang topologi dengan topologi subruang.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa jika <m>f</m> merupakan fungsi kontinu,
              maka <m>\Gamma_f</m> homeomorfik dengan <m>\R</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika syarat bahwa <m>f</m> kontinu dihilangkan,
              apakah tetap berlaku bahwa
              <m>\Gamma_f</m> homeomorfik dengan <m>\R</m>?
              Buktikan konjektur Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X</m> suatu himpunan tak kosong dan <m>p</m> suatu elemen tetap dalam <m>X</m>.
        Misalkan <m>\tau_p</m> merupakan topologi titik tertentu dan
        <m>\tau_{\overline{p}}</m> merupakan topologi titik yang dikecualikan pada <m>X</m>.
        Artinya,
        <ul>
          <li>
            <p>
              <m>\tau_{p}</m> merupakan koleksi himpunan bagian dari <m>X</m> yang terdiri atas <m>\emptyset</m>,
              <m>X</m>,
              dan semua himpunan bagian dari <m>X</m> yang memuat <m>p</m>.
            </p>
          </li>
          <li>
            <p>
              <m>\tau_{\overline{p}}</m> merupakan koleksi himpunan bagian dari <m>X</m> yang terdiri atas <m>\emptyset</m>,
              <m>X</m>,
              dan semua himpunan bagian dari <m>X</m> yang tidak memuat <m>p</m>.
            </p>
          </li>
        </ul>
      
      Fakta bahwa topologi titik tertentu dan topologi titik yang dikecualikan merupakan topologi menjadi pokok bahasan <xref ref="ex_particular_point_topology"/> dan <xref ref="ex_excluded_point_topology"/>.
      </p>
    </introduction>
      <task>
        <statement>
          <p>
            Misalkan <m>p</m> suatu titik tetap dalam <m>\R</m>.
            Apakah fungsi identitas <m>i: \R \to \R</m> yang didefinisikan oleh
            <m>i(x) = x</m> untuk semua <m>x \in \R</m> merupakan homeomorfisme dari
            <m>(\R, \tau_p)</m> ke <m>(\R, \tau_{\overline{p}})</m>?
            Buktikan jawaban Anda.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            Apakah <m>(\R, \tau_{p})</m> homeomorfik dengan
            <m>(\R, \tau_{\overline{p}})</m> ketika titik khususnya <m>p=0</m>?
            Buktikan jawaban Anda.
          </p>
        </statement>
      </task>
   

  </exercise>

  <exercise>
    <introduction>
      <p>
        Ruang topologi <m>X</m> <term>tertanam</term>
        dalam ruang topologi <m>Y</m> jika terdapat homeomorfisme dari <m>X</m> ke suatu subruang dari <m>Y</m>.
        Homeomorfisme tersebut disebut suatu <term>pembenaman</term>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa jika <m>X</m> merupakan interval terbuka <m>(0,1)</m> dengan topologi metrik Euklides,
              maka <m>X</m> dapat ditanamkan dalam ruang topologi <m>\R</m> dengan topologi metrik Euklides.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa terdapat ruang topologi <m>A</m> dan <m>B</m> yang tidak homeomorfik, tetapi <m>A</m> dapat ditanamkan dalam <m>B</m> dan <m>B</m> dapat ditanamkan dalam <m>A</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X = \{a,b\}</m> suatu himpunan dengan dua elemen.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Temukan semua topologi yang berbeda pada <m>X</m>.
              Jelaskan pula bagaimana Anda tahu bahwa semua topologi telah teridentifikasi.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Tentukan kelas-kelas homeomorfisme yang berbeda dari ruang topologi pada himpunan dua elemen.
              Berikan justifikasi atas jawaban Anda.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X = \{a,b,c\}</m>.
        Terdapat 29 topologi berbeda pada <m>X</m>, yang ditunjukkan di bawah.
        Tentukan banyaknya kelas homeomorfisme yang berbeda untuk 29 topologi ini dan identifikasi elemen-elemen setiap kelas homeomorfisme.
        Berikan justifikasi untuk jawaban Anda.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{c\}, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{c\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{c\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{a,b\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{a,b\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{c\}, \{a,c\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{b\}, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{c\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{c\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{b\}, \{a,b\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{b\}, \{a,b\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{c\}, \{a,c\}, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{a\}, \{c\}, \{a,c\}, \{b,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{c\}, \{b,c\}, \{a,b\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\{\emptyset, \{b\}, \{c\}, \{b,c\}, \{a,c\}, X\}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              topologi diskret
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Tunjukkan bahwa sifat <m>T_i</m> merupakan sifat topologis untuk setiap <m>i</m>.
        (Lihat <xref ref="chap_Closed_sets_topology"/>
        untuk definisi aksioma pemisahan.)
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawab benar jika pernyataan tersebut selalu benar.
        Jika pernyataan tersebut hanya kadang-kadang benar atau tidak pernah benar,
        jawab salah dan berikan contoh konkret yang menunjukkan bahwa pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Jika <m>f : X \to Y</m> merupakan fungsi kontinu antara ruang topologi <m>X</m> dan <m>Y</m>,
              maka untuk setiap himpunan bagian terbuka <m>U</m> dari <m>X</m>,
              <m>f(U)</m> terbuka dalam <m>Y</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>\tau_{FC}</m> merupakan topologi komplemen hingga,
              maka <m>f(x) = x^2</m> yang memetakan
              <m>(\R, \tau_{FC})</m> ke <m>(\R, \tau_{FC})</m> bersifat kontinu.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>f : X \to Y</m> merupakan fungsi bijektif antara ruang topologi <m>X</m> dan <m>Y</m>,
              dan untuk setiap himpunan bagian terbuka <m>U</m> dari <m>X</m>,
              <m>f(U)</m> terbuka dalam <m>Y</m>,
              maka <m>f</m> merupakan homeomorfisme.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>X</m> dan <m>Y</m> merupakan ruang topologi dengan topologi diskret,
              dan jika <m>f: X \to Y</m> merupakan bijeksi,
              maka ruang <m>X</m> dan <m>Y</m> homeomorfik.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>S</m> suatu himpunan dan <m>R_1</m> serta <m>R_2</m> merupakan relasi ekuivalensi pada <m>S</m>.
              Maka <m>R = R_1 \cap R_2</m> juga merupakan relasi ekuivalensi pada <m>S</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>S</m> suatu himpunan dan <m>R_1</m> serta <m>R_2</m> merupakan relasi ekuivalensi pada <m>S</m>.
              Maka <m>R = R_1 \cup R_2</m> juga merupakan relasi ekuivalensi pada <m>S</m>.
            </p>
          </statement>
        </task>
  
    </exercise>

</exercises>
