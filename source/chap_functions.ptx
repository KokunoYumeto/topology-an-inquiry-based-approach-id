  <xi:include  href="sec_comp_func.ptx"/>
  <xi:include  href="sec_inv_func.ptx"/>
  <xi:include  href="sec_fun_set.ptx"/>
  <xi:include  href="sec_card_set.ptx"/>
  <xi:include  href="sec_func_summ.ptx"/>
  <xi:include  href="sec_func_exer.ptx"/>
</chapter>
