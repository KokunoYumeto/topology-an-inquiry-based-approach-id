<exercises xml:id="sec_prod_top_exer">
  
  <exercise xml:id="ex_subbasis">
    
      <task>
        <statement>
          <p>
            Misalkan <m>(Y_1, \tau_1)</m> dan
            <m>(Y_2, \tau_2)</m> merupakan ruang topologi,
            dengan <m>Y_1 = \{a,b,c\}</m> dan <m>\tau_1 = \{\emptyset, \{a\}, \{b,c\}, Y_1\}</m>, serta
            <m>Y_2 = \{1,2\}</m> dan <m>\tau_2 = \{\emptyset, \{1\}, Y_2\}</m>.
            Carilah semua himpunan berbentuk
            <me>
              \CS = \{\pi_1^{-1}(O_1) \mid O_1 \text{ buka dalam }  Y_1\} \cup \{\pi_2^{-1}(O_2) \mid O_2 \text{ buka dalam }  Y_2\}
            </me>
            dan periksalah bahwa himpunan-himpunan tersebut membangkitkan topologi hasil kali pada <m>Y_1 \times Y_2</m>.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            Misalkan <m>X_{i}</m>, untuk <m>i</m> dari <m>1</m> sampai <m>n</m>, merupakan ruang topologi dan misalkan <m>X = \Pi_{i=1}^n X_i</m>.
            Tunjukkan bahwa koleksi
            <me>
              \CS = \bigcup_{i=1}^n \{\pi_i^{-1}(O_i) \mid O_i \text{ buka dalam }  X_i\}
            </me>
            merupakan subbasis bagi topologi kotak pada <m>X</m>.
          </p>
        </statement>
      </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>X</m> merupakan himpunan bilangan real dengan topologi metrik Euklides standar dan misalkan <m>Y</m> merupakan bilangan real dengan topologi diskret.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Jelaskan mengapa himpunan semua
              <q>interval horizontal</q>
              berbentuk
              <me>
                I= (a,b) \times \{c\} = \{(x,c) \mid a \lt  x \lt  b\}
              </me>
              merupakan basis bagi topologi hasil kali pada <m>X \times Y</m>.
            </p>
          </statement>
        </task>
        <task>
          <introduction>
            <p>
              Carilah interior dan penutup setiap subhimpunan <m>X \times Y</m> berikut.
            </p>
          </introduction>
              <task>
                <statement>
                  <p>
                    <m>A = \{(x,0) \mid 0 \leq x \lt 1\}</m>
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    <m>B = \{(0,y) \mid 0 \leq y \lt 1\}</m>
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    <m>C = \{(x,y) \mid 0 \leq x \lt 1, 0 \leq y \lt 1\}</m>
                  </p>
                </statement>
              </task>
            
          </task>
  </exercise>

  <exercise xml:id="ex_product_closure">
    <introduction>
      <p>
        Misalkan <m>X_1</m> dan <m>X_2</m> merupakan ruang topologi, misalkan <m>A_1</m> subhimpunan dari <m>X_1</m>, dan misalkan <m>A_2</m> subhimpunan dari <m>X_2</m>.
        Gunakan topologi hasil kali pada <m>X_1 \times X_2</m>.
        Buktikan setiap pernyataan berikut.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              <m>\overline{A_1 \times A_2} = \overline{A_1} \times \overline{A_2}</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>\Int(A_1 \times A_2) \subseteq \Int{A_1} \times \Int{A_2}</m>
            </p>
          </statement>
        </task>
  </exercise>

  <exercise xml:id="ex_unions_cross_products">
    <statement>
      <p>
        Misalkan <m>X</m> dan <m>Y</m> merupakan ruang topologi, dan misalkan <m>\{U_{\alpha}\}_{\alpha \in I}</m> serta
        <m>\{V_{\beta}\}_{\beta \in J}</m> merupakan koleksi himpunan buka masing-masing dalam <m>X</m> dan <m>Y</m>,
        untuk suatu himpunan indeks <m>I</m> dan <m>J</m>.
        Tunjukkan bahwa
        <me>
          \bigcup_{\substack{\alpha \in I \\ \beta \in J} } (U_{\alpha} \times V_{\beta}) = \left(\bigcup_{\alpha \in I} U_{\alpha} \right) \times  \left(\bigcup_{\beta \in J} V_{\beta} \right)
        </me>.
      </p>
    </statement>
  </exercise>

  <exercise>
  
      <task>
        <statement>
          <p>
            Jika <m>S_1</m>, <m>S_2</m>, <m>T_1</m>,
            dan <m>T_2</m> merupakan himpunan, tunjukkan bahwa
            <me>
              (S_1 \times T_1) \cap (S_2 \times T_2) = (S_1 \cap S_2) \times (T_1 \cap T_2)
            </me>.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            Jika <m>\CB_X</m> merupakan basis bagi topologi <m>\tau_X</m> pada ruang <m>X</m> dan <m>\CB_Y</m> merupakan basis bagi topologi <m>\tau_Y</m> pada ruang <m>Y</m>,
            tunjukkan bahwa <m>\CB_X \times \CB_Y</m> merupakan basis bagi topologi hasil kali pada <m>X \times Y</m>.
          </p>
        </statement>
      </task>
  </exercise>

  <exercise xml:id="ex_connected_product">
    <statement>
      <p>
        Buktikan bahwa hasil kali sembarang banyaknya ruang terhubung yang berhingga bersifat terhubung.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_compact_product">
    <statement>
      <p>
        Buktikan bahwa hasil kali sembarang banyaknya ruang kompak yang berhingga bersifat kompak.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_path_connected_product">
    
      <task>
        <statement>
          <p>
            Buktikan bahwa jika <m>(X_1, \tau_1)</m> dan
            <m>(X_2, \tau_2)</m> merupakan ruang topologi terhubung lintasan,
            maka <m>X_1 \times X_2</m> dengan topologi hasil kali merupakan ruang topologi terhubung lintasan.
          </p>
        </statement>
      </task>
      <task>
        <statement>
          <p>
            Buktikan bahwa hasil kali sembarang banyaknya ruang terhubung lintasan yang berhingga bersifat terhubung lintasan.
          </p>
        </statement>
      </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>X_1</m> dan <m>X_2</m> merupakan ruang topologi dan <m>X = X_1 \times X_2</m>.
        Benarkah bahwa jika <m>X</m> kompak,
        maka <m>X_1</m> dan <m>X_2</m> keduanya kompak?
        Buktikan jawaban Anda.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_projection_open">
    <statement>
      <p>
        Misalkan <m>X_1</m> dan <m>X_2</m> merupakan ruang topologi dan misalkan
        <m>\pi_i : X_1 \times X_2 \to X_i</m> pemetaan proyeksi.
        Kita telah menunjukkan bahwa <m>\pi_i</m> kontinu.
        Sekarang tunjukkan bahwa <m>\pi_i</m> merupakan pemetaan buka untuk <m>i</m> yang sama dengan 1 dan 2.
        Gunakan topologi hasil kali standar.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>X_1</m> dan <m>X_2</m> merupakan ruang topologi dengan kardinalitas sekurang-kurangnya 2.
        Misalkan <m>X = X_1 \times X_2</m>.
        Buktikan bahwa topologi ruang hasil kali pada
        <m>X = X_1 \times X_2</m> merupakan topologi diskret jika dan hanya jika topologi pada <m>X_1</m> dan <m>X_2</m> merupakan topologi diskret.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawablah benar jika pernyataan itu selalu benar.
        Jika pernyataan itu hanya kadang-kadang benar atau tidak pernah benar,
        jawablah salah dan berikan contoh konkret yang menunjukkan bahwa pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
        Sepanjang latihan ini, misalkan <m>X_1</m> dan <m>X_2</m> merupakan ruang topologi dan
        <m>X = X_1 \times X_2</m> dengan topologi hasil kali.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Jika <m>A_1 \subseteq X_1</m> dan <m>A_2 \subseteq X_2</m>,
              maka <m>(X_1 \times X_2) \setminus (A_1 \times A_2) = (X_1 \setminus A_1) \times (X_2 \setminus A_2)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A_1 \subseteq X_1</m> dan <m>A_2 \subseteq X_2</m>,
              maka <m>\Bdry(A_1 \times A_2) \subseteq \Bdry{A_1} \times \Bdry{A_2}</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>A_1 \subseteq X_1</m> dan <m>A_2 \subseteq X_2</m>,
              maka <m>\Bdry{A_1} \times \Bdry{A_2} \subseteq \Bdry(A_1 \times A_2)</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>O_1</m> subhimpunan buka dari <m>X_1</m> dan <m>O_2</m> subhimpunan buka dari <m>X_2</m>,
              maka <m>O_1 \times O_2</m> merupakan subhimpunan buka dari <m>X_1 \times X_2</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>O_1</m> subhimpunan dari <m>X_1</m> dan <m>O_2</m> subhimpunan dari <m>X_2</m>, serta
              <m>O_1 \times O_2</m> subhimpunan buka dari <m>X_1 \times X_2</m>,
              maka <m>O_1</m> merupakan subhimpunan buka dari <m>X_1</m> dan <m>O_2</m> merupakan subhimpunan buka dari <m>X_2</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>C_1</m> subhimpunan tertutup dari <m>X_1</m> dan <m>C_2</m> subhimpunan tertutup dari <m>X_2</m>,
              maka <m>C_1 \times C_2</m> merupakan subhimpunan tertutup dari <m>X_1 \times X_2</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>C_1</m> subhimpunan dari <m>X_1</m> dan <m>C_2</m> subhimpunan dari <m>X_2</m>, serta
              <m>C_1 \times C_2</m> subhimpunan tertutup dari <m>X_1 \times X_2</m>,
              maka <m>C_1</m> merupakan subhimpunan tertutup dari <m>X_1</m> dan <m>C_2</m> merupakan subhimpunan tertutup dari <m>X_2</m>.
            </p>
          </statement>
        </task>
  </exercise>
</exercises>
