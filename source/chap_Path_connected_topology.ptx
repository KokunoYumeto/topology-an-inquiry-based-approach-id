<chapter xmlns:xi="http://www.w3.org/2001/XInclude"  xml:id="chap_Path_connected_topology">
  <title>Ruang Terhubung Lintasan</title>
  
    <objectives>
      <ul>
        <li>
          <p>
            Apa yang dimaksud dengan lintasan dalam ruang topologi?
          </p>
        </li>
        <li>
          <p>
            Apa yang dimaksud dengan subhimpunan terhubung lintasan dari suatu ruang topologi?
          </p>
        </li>
        <li>
          <p>
            Apa yang dimaksud dengan komponen terhubung lintasan dari suatu ruang topologi?
          </p>
        </li>
        <li>
          <p>
            Apa yang dimaksud dengan ruang yang terhubung lintasan secara lokal?
          </p>
        </li>
        <li>
          <p>
            Apa hubungan antara ruang terhubung dan ruang terhubung lintasan?
          </p>
        </li>
      </ul>
    </objectives>
  
  <xi:include  href="sec_path_intro.ptx"/>
  <xi:include  href="sec_path_connect.ptx"/>
  <xi:include  href="sec_path_connect_equiv.ptx"/>
  <xi:include  href="sec_connectedness.ptx"/>
  <xi:include  href="sec_connect_finite.ptx"/>
  <xi:include  href="sec_connect_infinite.ptx"/>
  <xi:include  href="sec_path_summ.ptx"/>
  <xi:include  href="sec_path_exer.ptx"/>
</chapter>
