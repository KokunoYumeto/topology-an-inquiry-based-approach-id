<exercises xml:id="sec_metric_space_exer">
  <introduction>
    <definition xml:id="def_ms_open_ball">
      <idx><h>bola terbuka dalam ruang metrik</h></idx>
      <statement>
        <p>
          Misalkan <m>(Y, d_Y)</m> suatu ruang metrik.
          Untuk setiap bilangan real positif <m>r</m>,
          <term>bola terbuka yang berpusat di <m>b</m> dan berjari-jari</term>
          <m>r</m> dalam <m>(Y, d_Y)</m> adalah himpunan
          <me>
            B(b,r) = \{y \in Y \mid d_Y(y,b) \lt  r\}
          </me>.
        </p>
      </statement>
    </definition>
  </introduction>
  
  <exercise xml:id="ex_MS_discrete">
    <statement>
      <p>
        Misalkan <m>X</m> suatu himpunan.
        Tunjukkan bahwa fungsi <m>d</m>
        (metrik diskret) yang didefinisikan oleh
        <me>
          d(x,y) = \begin{cases}0 \amp  \text{ jika }  x=y \\ 1 \amp  \text{ jika }  x \neq y \end{cases}
        </me>
        merupakan metrik.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_MS_mod_metric">
  <introduction>
  
      <p>
        Misalkan <m>X = \{1,3,5\} \subset \Z</m> dan definisikan
        <m>d: X \times X \to \R</m> dengan <m>d(x,y) = xy - 1 \pmod{n}</m>.
        Artinya, <m>d(x,y)</m> adalah sisa pembagian <m>xy - 1</m> oleh <m>n</m>.
        <ul>
          <li>
            <p>
              Untuk setiap nilai <m>n</m>, tentukan apakah <m>d</m>
              mendefinisikan suatu metrik pada <m>X</m>.
              Buktikan jawaban Anda.
            </p>
          </li>
          <li>
            <p>
              Sebagai motivasi untuk definisi berikut, pada <m>\R^2</m> yang
              dilengkapi suatu metrik (tidak harus fungsi <m>d</m> di atas),
              lingkaran satuan adalah himpunan semua titik di <m>\R^2</m> yang
              berjarak <m>1</m> dari titik asal.
              Jika jaraknya kita syaratkan kurang dari <m>1</m>, kita memperoleh
              apa yang disebut bola terbuka.
              Definisi tersebut berlaku dalam setiap ruang metrik.
              Jika <m>(X,d)</m> merupakan ruang metrik untuk nilai <m>n</m>
              yang diberikan, tentukan semua bola terbuka dalam <m>X</m>
              yang berpusat di <m>1</m>.
              Jika <m>(X,d)</m> bukan ruang metrik, jelaskan alasannya.
            </p>
          </li>
        </ul>
        </p>
        </introduction>
        <task>
          <statement>
            <p>
              <m>n = 4</m>
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              <m>n = 8</m>
            </p>
          </statement>
        </task>
      
    </exercise>

    <exercise xml:id="ex_MS_Q_metric">
    <introduction>
      <p>
        Misalkan <m>Q</m> himpunan semua bilangan rasional dalam bentuk paling sederhana.
        Bilangan rasional <m>\frac{r}{s}</m> berada dalam bentuk paling sederhana
        jika <m>s \gt 0</m> serta <m>r</m> dan <m>s</m> tidak mempunyai faktor
        persekutuan yang lebih besar dari <m>1</m>.
        Definisikan <m>d : Q \times Q \to \R</m> dengan
        <me>
          d\left(\frac{a}{b}, \frac{r}{s}\right) = \max\{| a-r |, | b-s |\}
        </me>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Buktikan bahwa <m>d</m> merupakan metrik.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Suatu metrik memungkinkan kita menentukan unsur-unsur mana dalam
              ruang metrik yang “berdekatan”.
              Deskripsikan himpunan unsur di <m>Q</m> yang berjarak kurang dari
              <m>1</m> terhadap <m>\frac{2}{3}</m> dengan menggunakan metrik
              <m>d</m> ini.
              Dengan kata lain, deskripsikan bola terbuka berpusat di
              <m>\frac{2}{3}</m> dengan jari-jari <m>1</m>
              (lihat <xref ref="def_ms_open_ball"/>).
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Jika <m>a</m>, <m>b</m>, dan <m>c</m> merupakan unsur suatu ruang
              metrik <m>(X, d_X)</m>, kita mengatakan bahwa <m>b</m> berada di
              antara <m>a</m> dan <m>c</m> jika
              <m>d_X(a,c) = d_X(a,b) + d_X(b,c)</m>.
              Dengan metrik Euklides pada <m>\Q</m>, terdapat tak berhingga banyak
              bilangan rasional yang berbeda di antara <m>0</m> dan <m>1</m>
              (yaitu bilangan rasional di antara <m>0</m> dan <m>1</m> yang
              terletak pada garis Euklides melalui <m>0</m> dan <m>1</m>).
              Deskripsikan semua titik dalam <m>(\Q,d)</m> yang berada di antara
              <m>0</m> dan <m>1</m>.
            </p>
          </statement>
        </task>
    
    </exercise>

    <exercise>
    <introduction>
      <p>
        Misalkan <m>(\Q,d)</m> ruang metrik dari <xref ref="ex_MS_Q_metric"/>.
        Jika <m>a</m>, <m>b</m>, dan <m>c</m> merupakan unsur suatu ruang metrik
        <m>(X, d_X)</m>, kita mengatakan bahwa <m>b</m> berada
        <term>di antara</term> <m>a</m> dan <m>c</m> jika
        <m>d_X(a,c) = d_X(a,b) + d_X(b,c)</m>.
        Dengan metrik Euklides pada <m>\Q</m>, terdapat tak berhingga banyak
        bilangan rasional yang berbeda di antara <m>0</m> dan <m>1</m>
        (yaitu bilangan rasional di antara <m>0</m> dan <m>1</m> yang terletak
        pada garis Euklides melalui <m>0</m> dan <m>1</m>).
        Dalam latihan ini kita menyelidiki bilangan-bilangan yang berada di
        antara bilangan lain dalam ruang <m>(\Q,d)</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Temukan semua unsur dalam <m>(\Q,d)</m> yang berada di antara
              <m>0</m> dan <m>1</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Manakah yang lebih dekat ke <m>0</m> dalam <m>(\Q,d)</m>:
              <m>1</m> atau <m>\frac{1}{3}</m>?
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Sekarang temukan semua unsur dalam <m>(\Q,d)</m> yang berada di
              antara <m>0</m> dan <m>\frac{1}{3}</m>.
            </p>
          </statement>
        </task>
      
    </exercise>

    <exercise xml:id="ex_Taxicab">
    <statement>
      <p>
        Buktikan bahwa metrik taksi <m>d_T</m> merupakan metrik pada <m>\R^n</m>.
      </p>
    </statement>
    </exercise>

    <exercise xml:id="ex_Max">
    <introduction>
      <p>
        Misalkan <m>A</m> dan <m>B</m> subhimpunan berhingga tak kosong dari
        <m>\R</m>, dan misalkan
        <m>A+B = \{a+b \mid a \in A, b \in B\}</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Buktikan bahwa <m>\max (A+B) \leq \max A + \max B</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa metrik maksimum <m>d_M</m> merupakan metrik pada
              <m>\R^n</m>.
            </p>
          </statement>
        </task>
      
    </exercise>

    <exercise xml:id="ex_MS_hub">
    <introduction>
      <p>
        Jika <m>x = (x_1, x_2, \ldots, x_n)</m>, kita tuliskan
        <m>|x| = \sqrt{x_1^2+x_2^2+ \cdots + x_n^2}</m>.
        Untuk <m>x = (x_1, x_2, \ldots, x_n)</m> dan
        <m>y = (y_1, y_2, \ldots y_n)</m>, definisikan
        <m>d_H: \R^n \times \R^n \to \R</m> dengan
        <me>
          d_H(x,y) = \begin{cases}0 \amp \text{ jika }  x=y \\ |x|+|y| \amp \text{ selain itu } . \end{cases}
        </me>
        </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa <m>d_H</m> merupakan metrik
              (disebut <term>metrik hub</term>).
            </p>
          </statement>
        </task>
        <task>
              <task>
                <statement>
                  <p>
                    Misalkan <m>a = \left(\frac{1}{2}, 0\right)</m>.
                    Deskripsikan secara eksplisit titik-titik yang termasuk
                    dalam himpunan <m>B(a,1)</m> di <m>(\R^2, d_H)</m>.
                    (Lihat <xref ref="ex_MS_mod_metric"/> untuk definisi bola
                    terbuka.)
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Misalkan <m>a = (3,4)</m>.
                    Deskripsikan secara eksplisit titik-titik yang termasuk
                    dalam himpunan <m>B(a,1)</m> di <m>(\R^2, d_H)</m>.
                  </p>
                </statement>
              </task>
              <task>
                <statement>
                  <p>
                    Sekarang deskripsikan secara eksplisit semua bola terbuka
                    dalam <m>(\R^2, d_H)</m>.
                  </p>
                </statement>
              </task>
            
          </task>
        
    </exercise>
  
  <exercise>
    <introduction>
      <p>
        Misalkan <m>\Z</m> himpunan bilangan bulat dan <m>p</m> suatu bilangan prima.
        Untuk setiap pasangan bilangan bulat berbeda <m>m</m> dan <m>n</m>,
        terdapat bilangan bulat <m>t = t(m,n)</m> sedemikian sehingga
        <m>|m-n| = k \times p^t</m>, dengan <m>p</m> tidak membagi <m>k</m>.
        Sebagai contoh, jika <m>p=5</m>, <m>m = 34</m>, dan <m>n = 7</m>, maka
        <m>m-n = 27 = 27 \times 5^0</m>.
        Jadi <m>t(34,7) = 0</m>.
        Namun, jika <m>m = 54</m> dan <m>n = 4</m>, maka
        <m>m-n = 50 = 2 \times 5^2</m>.
        Jadi <m>t(54,4) = 2</m>.
        Definisikan <m>d: \Z \times \Z \to \R</m> dengan
        <me>
          d(m,n) = \begin{cases}0 \amp \text{ jika }  m=n \\ \frac{1}{p^t} \amp \text{ jika }  m \neq n. \end{cases}
        </me>
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Tentukan nilai <m>d(62,170)</m> dengan <m>p=3</m> dan
              <m>d(14008,2003)</m> dengan <m>p=7</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa jika <m>a</m>, <m>b</m>, dan <m>c</m> berada di
              <m>\Z</m>, maka
              <me>
                t(a,c) \geq \min\{t(a,b), t(b,c)\}
              </me>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Buktikan bahwa <m>(\Z,d)</m> merupakan ruang metrik.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>p = 3</m>.
              Deskripsikan himpunan semua unsur <m>x</m> dalam <m>(\Z,d)</m>
              yang memenuhi <m>d(x,0) = 1</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Tetap gunakan <m>p=3</m>.
              Deskripsikan himpunan semua unsur <m>x</m> dalam <m>(\Z,d)</m>
              yang memenuhi <m>d(x,0) \lt \frac{1}{2}</m>.
            </p>
          </statement>
        </task>
      
  </exercise>

  <exercise>
    <introduction>
      <p>
        Misalkan <m>(X, d_X)</m> dan <m>(Y, d_Y)</m> ruang-ruang metrik.
        Kita dapat menjadikan hasil kali Kartesius <m>X \times Y</m> suatu ruang
        metrik dengan mendefinisikan metrik <m>d'</m> pada <m>X \times Y</m>
        sebagai berikut.
        Jika <m>(x_1, y_1)</m> dan <m>(x_2, y_2)</m> berada di <m>X \times Y</m>, maka
        <me>
          d'((x_1,y_1), (x_2, y_2)) = \max\{d_X(x_1,x_2), d_Y(y_1,y_2)\}
        </me>.
        Anda boleh menganggap tanpa bukti bahwa <m>d'</m> merupakan metrik pada
        <m>X \times Y</m>.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>(X, d_X) = (\R^2, d_M)</m> dan
              <m>(Y, d_Y) = (\R^2, d_T)</m>.
              Misalkan <m>u = ((1,2), (1,-1))</m> dan
              <m>v = ((0,5),(2,-2))</m>.
              Berapakah
              <me>
                d'(u,v)?
              </me>
              Ingat bahwa
              <me>
                d_M((x_1,x_2),(y_1,y_2)) = \max\{ | x_1-y_1 |, | x_2-y_2 |\}
              </me>
              dan
              <me>
                d_T((x_1,x_2),(y_1,y_2)) = | x_1-y_1 | + | x_2-y_2 |
              </me>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>(X, d_X) = (\R, d_E)</m> dan
              <m>(Y, d_Y) = (\R, d)</m>, dengan <m>d</m> metrik diskret.
              Misalkan
              <me>
                A=\{(x,y) \in \R \times \R \mid -1\leq x \leq 1 \text{ dan }  -1 \leq y \leq 1\}
              </me>
              di <m>X \times Y</m>.
              Misalkan <m>a = (0,1)</m> di <m>X \times Y</m>.
              Deskripsikan secara geometris bentuk bola terbuka <m>B(a,1)</m>
              dalam ruang hasil kali <m>X \times Y</m>.
              Gambarlah bola terbuka ini.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>X = \R^+</m>, himpunan bilangan real positif, dan definisikan
        <m>d: X \times X \to \R</m> dengan
        <me>
          d(x,y) = |\ln(y/x)|
        </me>.
        Apakah <m>d</m> merupakan metrik pada <m>X</m>?
        Buktikan jawaban Anda.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex_1_over_1_plus_t_metric">
    <statement>
      <p>
        Misalkan <m>d: \R \times \R \to \R</m> didefinisikan oleh
        <me>
          d(x,y) = \frac{|x-y|}{|x-y|+1}
        </me>.
        Tunjukkan bahwa <m>d</m> merupakan metrik pada <m>\R</m>.
        (Petunjuk: Untuk pertidaksamaan segitiga, perhatikan bahwa
        <m>d(x,y) = f(|x-y|)</m>, dengan <m>f(t) = \frac{t}{t+1}</m>, dan <m>f</m>
        merupakan fungsi naik.)
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Misalkan <m>(X,d)</m> suatu ruang metrik dan <m>k</m> suatu konstanta.
        Definisikan <m>kd: X \times X \to \R</m> dengan
        <me>
          (kd)(x,y) = kd(x,y)
        </me>.
        Dengan syarat apa, jika ada, <m>kd</m> merupakan metrik pada <m>X</m>?
        Jelaskan alasan Anda.
      </p>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Fungsi bernilai real <m>f</m> pada suatu interval disebut
        <term>cekung</term> jika
        <men xml:id="eq_concave">
          f((1-\alpha)x + \alpha y) \geq (1-\alpha)f(x) + \alpha f(y)
        </men>
        untuk setiap <m>\alpha \in [0,1]</m> dan setiap <m>x</m> serta <m>y</m>
        dalam interval tersebut.
        Perhatikan bahwa ekspresi <m>(1-\alpha)x + \alpha y</m> linear terhadap
        <m>\alpha</m>, bernilai <m>x</m> ketika <m>\alpha = 0</m>, dan bernilai
        <m>y</m> ketika <m>\alpha = 1</m>.
        Jadi <m>(1-\alpha)x + \alpha y</m> merupakan parameterisasi ruas garis
        yang menghubungkan <m>x</m> dengan <m>y</m>.
        Seperti diperlihatkan <xref ref="F_concave"/>, persamaan
        <xref ref="eq_concave"/> menyatakan bahwa grafik fungsi cekung <m>f</m>
        pada setiap interval <m>[x,y]</m> terletak di atas garis sekan yang
        menghubungkan titik <m>(x,f(x))</m> dan <m>(y,f(y))</m>.
      </p>
      <figure xml:id="F_concave">
          <caption>Suatu fungsi cekung.</caption>
          <image width="50%" source="Concave"><description>Grafik sebuah fungsi cekung melengkung di atas garis sekan yang menghubungkan dua titik pada grafik.</description></image>
        </figure>
    </introduction>
        <task>
          <statement>
            <p>
              Misalkan <m>f(x) = -x^2</m> memetakan <m>\R</m> ke <m>\R</m>
              dengan metrik Euklides standar.
              Tunjukkan bahwa <m>f</m> cekung pada interval <m>[-1,1]</m>.
            </p>
          </statement>
          <hint>
            <p>
              Mulailah dari fakta bahwa
              <m>\alpha(1-\alpha)(x-y)^2 \geq 0</m>.
            </p>
          </hint>
        </task>
        <task>
          <statement>
            <p>
              Tunjukkan bahwa jika <m>f</m> merupakan fungsi cekung pada
              <m>[0,\infty)</m> dan <m>f(0) \geq 0</m>.
              Jika <m>a</m> dan <m>b</m> berada dalam interval tersebut, maka
              <me>
                f(a) + f(b) \geq f(a+b)
              </me>.
            </p>
          </statement>
          <hint>
                <p>
                  Tinjau <xref ref="eq_concave"/> dengan <m>y=0</m>.
                  Lalu gunakan fakta bahwa <m>\frac{a}{a+b}</m> berada di
                  <m>[0,1]</m>.
                </p>
              </hint>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>(X,d)</m> suatu ruang metrik dan
              <m>f: [0, \infty) \to [0, \infty)</m> suatu fungsi naik dan cekung
              sedemikian sehingga <m>f(x) = 0</m> jika dan hanya jika <m>x=0</m>.
              Buktikan bahwa <m>f \circ d</m> merupakan metrik pada <m>X</m>.
            </p>
          </statement>
        </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Untuk setiap pernyataan berikut, jawablah benar jika pernyataan itu
        selalu benar.
        Jika pernyataan itu hanya kadang-kadang benar atau tidak pernah benar,
        jawablah salah dan berikan contoh konkret yang menunjukkan bahwa
        pernyataan tersebut salah.
        Jika suatu pernyataan benar, jelaskan alasannya.
      </p>
    </introduction>
        <task>
          <statement>
            <p>
              Fungsi <m>d: \R \times \R \to \R</m> yang didefinisikan oleh
              <m>d(x,y) = (x-y)^2</m> merupakan metrik pada <m>\R</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Setiap himpunan tak kosong dapat dijadikan ruang metrik.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Pada setiap himpunan yang memuat sekurang-kurangnya dua unsur,
              dapat didefinisikan tak berhingga banyak metrik.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>(X, d_X)</m> dan <m>(Y, d_Y)</m> ruang-ruang metrik
              dengan <m>|X| \geq 2</m>.
              Maka fungsi <m>d: (X \times Y) \times (X \times Y) \to \R</m> yang didefinisikan oleh
              <m>d((a,b),(c,d)) = d_X(a,c)d_Y(b,d)</m> merupakan metrik pada
              <m>X \times Y</m>.
            </p>
          </statement>
        </task>
        <task>
          <statement>
            <p>
              Misalkan <m>(X,d)</m> suatu ruang metrik.
              Jika <m>X</m> tak berhingga, maka daerah hasil <m>d</m> juga
              merupakan himpunan tak berhingga.
            </p>
          </statement>
        </task>
      
    </exercise>
  </exercises>
