    <title>Topologi: Pendekatan Berbasis Inkuiri</title>
    <subtitle>Bab 1 — Himpunan dan Pendamping Belajar Mandiri</subtitle>
    <frontmatter>
      <titlepage>
        <author>
          <personname>Steven Schlicker</personname>
          <institution>Grand Valley State University</institution>
